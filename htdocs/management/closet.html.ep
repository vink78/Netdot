% my $left       = $c->stash('left')       // [];
% my $right      = $c->stash('right')      // [];
% my $info       = $c->stash('info')       // '';
% my $devices    = $c->stash('devices')    // [];
% my $backbones  = $c->stash('backbones')  // [];
% my $horizontal = $c->stash('horizontal') // [];
% my $pictures   = $c->stash('pictures')   // [];

<h1><%= $title %></h1>

<p><a href="<%= url_for('closet_list') %>">&laquo; Closet</a></p>

% if ( defined $left && @$left || defined $right && @$right ) {
<div style="margin:1em 0 0.5em 0">
  <table width="100%" border="0" cellpadding="0" cellspacing="0">
    <tr valign="top">
      <td width="50%" style="vertical-align:top; padding-right:1.5em">
        % if (@$left) {
        <table class="datatable detail">
          <tbody>
            % for my $a (@$left) {
            <tr><th><%= $a->[0] %></th><td>
              % if ( defined $a->[2] && length $a->[2] ) {
              <a href="<%= $a->[2] %>"><%= $a->[1] %></a>
              % } else {
              <%= $a->[1] %>
              % }
            </td></tr>
            % }
          </tbody>
        </table>
        % }
      </td>
      <td width="50%" style="vertical-align:top">
        % if (@$right) {
        <table class="datatable detail">
          <tbody>
            % for my $a (@$right) {
            <tr><th><%= $a->[0] %></th><td>
              % if ( defined $a->[2] && length $a->[2] ) {
              <a href="<%= $a->[2] %>"><%= $a->[1] %></a>
              % } else {
              <%= $a->[1] %>
              % }
            </td></tr>
            % }
          </tbody>
        </table>
        % }
      </td>
    </tr>
  </table>
  % if ( defined $info && length $info ) {
  <h3 style="font-size:0.95em; margin:0.8em 0 0.2em 0">Info</h3>
  <p style="white-space:pre-wrap; margin:0"><%= $info %></p>
  % }
</div>
% }

% if (@$devices) {
<div style="margin:1.2em 0 0.5em 0">
  <h2 style="font-size:1.05em; border-bottom:1px solid #ddeedd; padding-bottom:2px">Device List (<%= scalar @$devices %>)</h2>
  <table class="datatable">
    <thead><tr><th>Device</th><th>IPv4</th><th>IPv6</th></tr></thead>
    <tbody>
      % for my $row (@$devices) {
      <tr>
        % for my $cell (@$row) {
        % my ($t, $h) = @$cell;
        <td>
          % if ($h) {
          <a href="<%= $h %>"><%= $t %></a>
          % } else {
          <%= $t // '' %>
          % }
        </td>
        % }
      </tr>
      % }
    </tbody>
  </table>
</div>
% }

% if (@$backbones) {
<div style="margin:1.2em 0 0.5em 0">
  <h2 style="font-size:1.05em; border-bottom:1px solid #ddeedd; padding-bottom:2px">Backbone Cable (<%= scalar @$backbones %>)</h2>
  <table class="datatable">
    <thead><tr><th>Name</th><th>Type</th><th>Start Closet</th><th>End Closet</th><th>Owner</th></tr></thead>
    <tbody>
      % for my $row (@$backbones) {
      <tr>
        % for my $cell (@$row) {
        % my ($t, $h) = @$cell;
        <td>
          % if ($h) {
          <a href="<%= $h %>"><%= $t %></a>
          % } else {
          <%= $t // '' %>
          % }
        </td>
        % }
      </tr>
      % }
    </tbody>
  </table>
</div>
% }

% if (@$horizontal) {
<div style="margin:1.2em 0 0.5em 0">
  <h2 style="font-size:1.05em; border-bottom:1px solid #ddeedd; padding-bottom:2px">Horizontal Cable (<%= scalar @$horizontal %>)</h2>
  <table class="datatable">
    <thead><tr><th>Jack ID</th><th>Type</th><th>Room</th></tr></thead>
    <tbody>
      % for my $row (@$horizontal) {
      <tr>
        % for my $cell (@$row) {
        % my ($t, $h) = @$cell;
        <td>
          % if ($h) {
          <a href="<%= $h %>"><%= $t %></a>
          % } else {
          <%= $t // '' %>
          % }
        </td>
        % }
      </tr>
      % }
    </tbody>
  </table>
</div>
% }

% if (@$pictures) {
<div style="margin:1.2em 0 0.5em 0">
  <h2 style="font-size:1.05em; border-bottom:1px solid #ddeedd; padding-bottom:2px">Pictures (<%= scalar @$pictures %>)</h2>
  <table class="datatable">
    <thead><tr><th>File Name</th><th>Size</th><th>File Type</th><th>Comments</th></tr></thead>
    <tbody>
      % for my $row (@$pictures) {
      <tr>
        % for my $cell (@$row) {
        % my ($t, $h) = @$cell;
        <td>
          % if ($h) {
          <a href="<%= $h %>" target="_blank"><%= $t %></a>
          % } else {
          <%= $t // '' %>
          % }
        </td>
        % }
      </tr>
      % }
    </tbody>
  </table>
</div>
% }
