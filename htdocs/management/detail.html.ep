<h1><%= $title %></h1>

<p>
  <a href="<%= url_for( $type . '_list' ) %>">&laquo; <%= ucfirst($type) %></a>
  % if ( $can_edit && @$fields ) {
  <button type="button" class="btn" id="nd-edit-toggle" style="margin-left:1.2em">Edit</button>
  % }
</p>

% if (@$attrs) {
%   # Fields table: Device-Basics "General" look (datatable.detail, 2 label/value
%   # pairs per row), no section header. Chunk the flat attr list into rows of 2.
%   my $N    = 2;
%   my @list = @$attrs;
  <table class="datatable detail c2" id="nd-readonly">
    <tbody>
    % for (my $i = 0; $i < @list; $i += $N) {
    %   my $end = $i + $N - 1; $end = $#list if $end > $#list;
    %   my @r   = @list[$i .. $end];
    <tr>
      % for my $a (@r) {
      %   my ( $tag, $text, $href ) = @$a;
      <th><%= $tag %></th>
      <td>
        % if ( defined $href ) {
        <a href="<%= $href %>"><%= $text %></a>
        % } else {
        <%= $text // '' %>
        % }
      </td>
      % }
    </tr>
    % }
    </tbody>
  </table>
% } else {
  <p>No attribute.</p>
% }

% if ( $can_edit && @$fields ) {
%   my @fl = @$fields;
<form id="nd-edit" data-nd-api="<%= $api_path %>" data-nd-method="PATCH" data-nd-api-base="<%= $c->web_prefix %>/api" style="display:none">
  <table class="datatable detail c2">
    <tbody>
    % for ( my $i = 0; $i < @fl; $i += 2 ) {
    %   my $end = $i + 1; $end = $#fl if $end > $#fl;
    %   my @row = @fl[ $i .. $end ];
    <tr>
      % for my $f (@row) {
      <th><%= $f->{tag} %></th>
      <td>
        % if ( $f->{kind} eq 'checkbox' ) {
        <input type="checkbox" name="<%= $f->{name} %>"<%= $f->{value} ? ' checked' : '' %>>
        % } elsif ( $f->{kind} eq 'textarea' ) {
        <textarea name="<%= $f->{name} %>" rows="3"><%= $f->{value} %></textarea>
        % } elsif ( $f->{kind} eq 'number' ) {
        <input type="number" name="<%= $f->{name} %>" value="<%= $f->{value} %>">
        % } elsif ( $f->{kind} eq 'fk' ) {
        %   if ( $f->{options} ) {
        %     # Small target table: plain <select> of all options (server-filled).
        <select name="<%= $f->{name} %>" class="nd-fk-select">
          <option value="">-- Select --</option>
          % for my $op ( @{ $f->{options} } ) {
          <option value="<%= $op->{id} %>"<%= ( $f->{cur_id} && $f->{cur_id} == $op->{id} ) ? ' selected' : '' %>><%= $op->{label} %></option>
          % }
          <option value="">[null]</option>
        </select>
        %   } else {
        %     # Large target (RR/Ipblock): keyword search box + <select> filled on
        %     # search via the API (never dumps 100K+ options).
        <span class="nd-fk-search">
          <input type="text" class="nd-fk-kw" placeholder="Search…" data-nd-target="<%= $f->{target} %>" data-nd-max="<%= $f->{max} %>">
          <button type="button" class="btn nd-fk-go">List</button>
          <select name="<%= $f->{name} %>" class="nd-fk-select">
            <option value="">-- Search --</option>
            % if ( $f->{cur_id} ) {
            <option value="<%= $f->{cur_id} %>" selected><%= $f->{cur_label} %></option>
            % }
            <option value="">[null]</option>
          </select>
        </span>
        %   }
        % } else {
        <input type="text" name="<%= $f->{name} %>" value="<%= $f->{value} %>">
        % }
      </td>
      % }
    </tr>
    % }
    </tbody>
  </table>
  <p style="margin-top:0.8em">
    <button type="submit" class="btn">Save</button>
    <button type="button" class="btn" id="nd-edit-cancel" style="margin-left:0.6em">Cancel</button>
  </p>
</form>
% }

% my $relations = $c->stash->{relations} // [];
% my $dbase     = $c->set_uri( "/management/$type/$id" );
% my $active    = $c->param('rel');
% my $multi     = scalar(@$relations) > 1;
% if (@$relations) {
<div class="tabcard">
% if ($multi) {
%   # Default to the first relation unless ?rel= names a valid one.
%   $active = $relations->[0]->{csv_rel}
%         unless defined $active && grep { $_->{csv_rel} eq $active } @$relations;
<div class="tabbar">
   % for my $r (@$relations) {
    <a class="tab<%= $active eq $r->{csv_rel} ? ' active' : '' %>"
       hx-boost="false" data-rel="<%= $r->{csv_rel} %>"
       href="<%= $dbase . '?rel=' . $r->{csv_rel} %>"><%= $r->{title} %></a>
   % }
</div>
% }
<div class="tabcard-body">
% for my $r (@$relations) {
  % my $rel   = $r->{csv_rel};
  % my $rlink = sub { my $off = shift; return $dbase . '?rel=' . $rel . ( ( defined $off && $off > 0 ) ? '&offset=' . $off : '' ); };
  <div class="tab-pane" data-rel="<%= $rel %>"<%= ($multi && $active ne $rel) ? ' hidden' : '' %>>
    <table class="datatable">
      <thead>
        <tr>
        % for my $h ( @{ $r->{cols} } ) {
        <th><%= $h %></th>
        % }
        </tr>
      </thead>
      <tbody>
        % for my $row ( @{ $r->{rows} } ) {
        <tr>
          % for my $cell ( @$row ) {
          % my ($t, $h) = @$cell;
          <td>
            % if ($h) {
            <a href="<%= $h %>"><%= $t %></a>
            % } else {
            <%= $t // '' %>
            % }
          </td>
          % }
        </tr>
        % }
      </tbody>
    </table>
    <p style="font-size:0.85em; margin:0.3em 0 0 0">
      % if ( $r->{total} > $r->{per} ) {
      Results: [<%= $r->{start} %>-<%= $r->{last_item} %>] of <%= $r->{total} %>&nbsp;
      % if ( $r->{offset} > 0 ) {
      <a href="<%= $r->{offset} >= $r->{per} ? $rlink->( $r->{offset} - $r->{per} ) : $rlink->() %>">&laquo;</a>&nbsp;
      % }
      % if ( $r->{offset} + $r->{per} < $r->{total} ) {
      <a href="<%= $rlink->( $r->{offset} + $r->{per} ) %>">&raquo;</a>
      % }
      &nbsp;
      % }
      <a href="<%= $dbase . '?csv=' . $rel %>">[csv]</a>
    </p>
  </div>
% }
</div>
</div>
% }
