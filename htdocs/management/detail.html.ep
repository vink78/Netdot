<h1><%= ucfirst($type) %> #<%= $id %></h1>

<p><a href="<%= url_for( $type . '_list' ) %>">&laquo; <%= ucfirst($type) %></a></p>

% if (@$attrs) {
  <table class="sortable detail">
    <tbody>
      % for my $a (@$attrs) {
      <tr><th><%= $a->[0] %></th><td>
        % if ( defined $a->[2] ) {
        <a href="<%= $a->[2] %>"><%= $a->[1] %></a>
        % } else {
        <%= $a->[1] %>
        % }
      </td></tr>
      % }
    </tbody>
  </table>
% } else {
  <p>No attribute.</p>
% }
