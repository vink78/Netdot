<h1><%= $title %></h1>

<p><a href="<%= url_for( $type . '_list' ) %>">&laquo; <%= ucfirst($type) %></a></p>

% if (@$attrs) {
  <table class="sortable detail">
    <tbody>
      % for my $a (@$attrs) {
      <tr><th><%= $a->[0] %></th><td style="white-space:pre-wrap">
        % if ( defined $a->[2] ) {
        <a href="<%= $a->[2] %>"><%= $a->[1] %></a>
        % } else {
        <%= $a->[1] %>
        % }
      </td></tr>
      % }
    </tbody>
  </table>
% } else {
  <p>No attribute.</p>
% }

% my $relations = $c->stash->{relations} // [];
% my $dbase     = "/management/$type/$id";
% if (@$relations) {
% for my $r (@$relations) {
<div style="margin:1.2em 0 0.5em 0">
  <h2 style="font-size:1.05em; border-bottom:1px solid #ddeedd; padding-bottom:2px"><%= $r->{title} %></h2>
  <table class="sortable">
    <thead>
      <tr>
      % for my $h ( @{ $r->{cols} } ) {
      <th><%= $h %></th>
      % }
      </tr>
    </thead>
    <tbody>
      % for my $row ( @{ $r->{rows} } ) {
      <tr>
        % for my $cell ( @$row ) {
        % my ($t, $h) = @$cell;
        <td>
          % if ($h) {
          <a href="<%= $h %>"><%= $t %></a>
          % } else {
          <%= $t // '' %>
          % }
        </td>
        % }
      </tr>
      % }
    </tbody>
  </table>
  <p style="font-size:0.85em; margin:0.3em 0 0 0">
    % if ( $r->{total} > $r->{per} ) {
    Results: [<%= $r->{start} %>-<%= $r->{last_item} %>] of <%= $r->{total} %>&nbsp;
    % if ( $r->{offset} > 0 ) {
    <a href="<%= $r->{offset} >= $r->{per} ? ( $dbase . '?offset=' . ( $r->{offset} - $r->{per} ) ) : $dbase %>">&laquo;</a>&nbsp;
    % }
    % if ( $r->{offset} + $r->{per} < $r->{total} ) {
    <a href="<%= $dbase . '?offset=' . ( $r->{offset} + $r->{per} ) %>">&raquo;</a>
    % }
    &nbsp;
    % }
    <a href="<%= $dbase . '?csv=' . $r->{csv_rel} %>">[csv]</a>
  </p>
</div>
% }
% }
