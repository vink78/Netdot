<h1><%= $title %></h1>

% my $can_delete = $c->stash('can_delete');
% my $del_path   = $c->stash('del_path') // '';
% my $del_goto   = $c->stash('del_goto') // '';
<p>
  <a href="<%= url_for( $type . '_list' ) %>">&laquo; <%= ucfirst($type) %></a>
  % if ( $can_edit && @$fields ) {
  <button type="button" class="btn" id="nd-edit-toggle" style="margin-left:1.2em">Edit</button>
  % }
  % if ( $c->stash('setpass_api') ) {
  % # Person pages, Admins only: dedicated password box (see initSetPassword).
  <button type="button" class="btn" id="nd-setpass-toggle" style="margin-left:0.6em">Password</button>
  % }
  % if ( $can_delete ) {
  <button type="button" class="btn nd-rec-delete" data-nd-del="<%= $del_path %>" data-nd-goto="<%= $del_goto %>" style="margin-left:0.6em">Delete</button>
  % }
</p>

% if (@$attrs) {
%   # Fields table: Device-Basics "General" look (datatable.detail, 2 label/value
%   # pairs per row), no section header. Chunk the flat attr list into rows of 2.
%   my $N    = 2;
%   my @list = @$attrs;
  <table class="datatable detail c2" id="nd-readonly">
    <tbody>
    % for (my $i = 0; $i < @list; $i += $N) {
    %   my $end = $i + $N - 1; $end = $#list if $end > $#list;
    %   my @r   = @list[$i .. $end];
    <tr>
      % for my $a (@r) {
      %   my ( $tag, $text, $href ) = @$a;
      <th><%= $tag %></th>
      <td>
        % if ( defined $href ) {
        <a href="<%= $href %>"><%= $text %></a>
        % } else {
        <%= $text // '' %>
        % }
      </td>
      % }
    </tr>
    % }
    </tbody>
  </table>
% } else {
  <p>No attribute.</p>
% }

<%= $c->render_to_string( template => 'management/_edit_form', layout => 0,
                          can_edit => $can_edit, fields => $fields, api_path => $api_path ) %>

% # Person pages (Admins): dedicated password box. The generic edit form excludes
% # the sensitive `password` column, so the new password goes through its own
% # small form (wired by netdot.js initSetPassword, skipped by the generic
% # form handler): new + repeat fields, checked client-side, PATCHes the same
% # API endpoint with {password} — the model's trigger hashes it server-side.
% my $setpass_api = $c->stash('setpass_api');
% if ($setpass_api) {
<form id="nd-setpass" class="nd-setpass" data-nd-api="<%= $setpass_api %>" style="display:none; margin-top:0.8em">
  <table class="datatable detail c2">
    <tbody>
    <tr>
      <th>New password</th>
      <td><input type="password" name="password" autocomplete="new-password"></td>
    </tr>
    <tr>
      <th>Repeat new password</th>
      <td><input type="password" name="password_repeat" autocomplete="new-password"></td>
    </tr>
    </tbody>
  </table>
  <p style="margin-top:0.8em">
    <button type="submit" class="btn">Set password</button>
    <button type="button" class="btn" id="nd-setpass-cancel" style="margin-left:0.6em">Cancel</button>
  </p>
</form>
% }

% my $relations = $c->stash->{relations} // [];
% my $dbase     = $c->set_uri( "/management/$type/$id" );
% my $active    = $c->param('rel');
% my $multi     = scalar(@$relations) > 1;
% if (@$relations) {
<div class="tabcard">
% if ($multi) {
%   # Default to the first relation unless ?rel= names a valid one.
%   $active = $relations->[0]->{csv_rel}
%         unless defined $active && grep { $_->{csv_rel} eq $active } @$relations;
<div class="tabbar">
   % for my $r (@$relations) {
    <a class="tab<%= $active eq $r->{csv_rel} ? ' active' : '' %>"
       hx-boost="false" data-rel="<%= $r->{csv_rel} %>"
       href="<%= $dbase . '?rel=' . $r->{csv_rel} %>"><%= $r->{title} %></a>
   % }
</div>
% }
<div class="tabcard-body">
% for my $r (@$relations) {
  % my $rel   = $r->{csv_rel};
  % my $rlink = sub { my $off = shift; return $dbase . '?rel=' . $rel . ( ( defined $off && $off > 0 ) ? '&offset=' . $off : '' ); };
  <div class="tab-pane" data-rel="<%= $rel %>"<%= ($multi && $active ne $rel) ? ' hidden' : '' %>>
    % if ( $r->{total} ) {
    % # Row write affordances (Detail::build_relations): an Edit control that
    % # reveals the row's in-table form (nd_row _edit_form, PATCH
    % # /api/<table>/<id>; netdot.js initRowEdits + initForms); a Remove
    % # control that breaks the link while keeping the related object (row
    % # delete for join / role rows, parent-FK null for direct FK rows —
    % # netdot.js initRowRemoves); a Delete control (the .nd-rec-delete
    % # handler, DELETE /api/<table>/<id>; Device / Ipblock rows carry the
    % # dedicated confirm options). The API re-checks the per-object right.
    % my $row_act = ( $r->{can_edit} || $r->{can_del} || $r->{can_remove} ) ? 1 : 0;
    <table class="datatable">
      <thead>
        <tr>
        % for my $h ( @{ $r->{cols} } ) {
        <th><%= $h %></th>
        % }
        % if ($row_act) {
        <th></th>
        % }
        </tr>
      </thead>
      <tbody>
        % my $ri = 0;
        % for my $row ( @{ $r->{rows} } ) {
        %   my $rid = ( defined $r->{ids} && $r->{ids}[$ri] ) ? $r->{ids}[$ri] : undef;
        <tr class="nd-row-ro">
          % for my $cell ( @$row ) {
          % my ($t, $h) = @$cell;
          <td>
            % if ($h) {
            <a href="<%= $h %>"><%= $t %></a>
            % } else {
            <%= $t // '' %>
            % }
          </td>
          % }
          % if ( $row_act && $rid ) {
          <td class="nd-row-act">
            % if ( $r->{can_edit} ) {
            <button type="button" class="btn nd-row-edit">Edit</button>
            % }
            % if ( $r->{can_remove} ) {
            <button type="button" class="btn nd-row-remove"
                    data-nd-remove="<%= $r->{remove_kind} %>"
            % if ( $r->{remove_kind} eq 'row' ) {
                    data-nd-del="<%= $c->web_prefix . '/api/' . $r->{table} . '/' . $rid %>"
            % } else {
                    data-nd-api="<%= $c->web_prefix . '/api/' . $r->{table} . '/' . $rid %>"
                    data-nd-fk="<%= $r->{remove_fk} %>"
            % }
                    data-nd-type="<%= lc( $r->{related} ) %>"
                    style="margin-left:0.4em">Remove</button>
            % }
            % if ( $r->{can_del} && $r->{remove_kind} ne 'row' ) {
            <button type="button" class="btn nd-rec-delete"
                    data-nd-del="<%= $c->web_prefix . '/api/' . $r->{table} . '/' . $rid %>"
            % if ( $r->{related} eq 'Device' ) {
                    data-nd-device="1"
            % }
            % if ( $r->{related} eq 'Ipblock' ) {
                    data-nd-ipblock="1" data-nd-children="<%= $r->{n_children}[$ri] %>"
            % }
                    style="margin-left:0.4em">Delete</button>
            % }
          </td>
          % }
        </tr>
        % if ( $r->{can_edit} && $rid && defined $r->{edit_rows} && $r->{edit_rows}[$ri] ) {
        <tr class="nd-row-form" style="display:none">
          <td colspan="<%= scalar( @{ $r->{cols} } ) + 1 %>">
            <%= $c->render_to_string( template => 'management/_edit_form', layout => 0,
                                      can_edit => 1, fields => $r->{edit_rows}[$ri],
                                      api_path => $c->web_prefix . '/api/' . $r->{table} . '/' . $rid,
                                      nd_method => 'PATCH', nd_row => 1 ) %>
          </td>
        </tr>
        % }
        % $ri++;
        % }
      </tbody>
    </table>
    % } else {
    <p>No attribute.</p>
    % }
    <p style="font-size:0.85em; margin:0.3em 0 0 0">
      % if ( $r->{total} > $r->{per} ) {
      Results: [<%= $r->{start} %>-<%= $r->{last_item} %>] of <%= $r->{total} %>&nbsp;
      % if ( $r->{offset} > 0 ) {
      <a href="<%= $r->{offset} >= $r->{per} ? $rlink->( $r->{offset} - $r->{per} ) : $rlink->() %>">&laquo;</a>&nbsp;
      % }
      % if ( $r->{offset} + $r->{per} < $r->{total} ) {
      <a href="<%= $rlink->( $r->{offset} + $r->{per} ) %>">&raquo;</a>
      % }
      &nbsp;
      % }
      <a href="<%= $dbase . '?csv=' . $rel %>">[csv]</a>
    </p>
    % # Generic "Add" form of this relation (stashed by Show#show, built by
    % # Detail::relation_adds): the port of the legacy view.html [add] link on
    % # the section (edit.html?table=<child>&<fk>=<parent>). The shared
    % # _edit_form partial in create mode -> POST /api/<table>; the parent FK
    % # is a hidden pre-filled field; initForms (netdot.js) handles the submit
    % # and reloads the page on success.
    % if ( my $ra = ( $c->stash('rel_adds') // {} )->{$rel} ) {
    <div style="margin-top:0.8em">
      <%= $c->render_to_string( template => 'management/_edit_form', layout => 0,
                                can_edit => 1, fields => $ra->{fields},
                                api_path => $c->web_prefix . '/api/' . $ra->{table},
                                nd_create => 1, nd_method => 'POST',
                                nd_label  => 'Add' ) %>
    </div>
    % }
  </div>
% }
</div>
</div>
% }
