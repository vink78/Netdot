<%# MAC (PhysAddr) detail: read-only port of mac.html. %>
<% my $title      = $c->stash->{title} // 'MAC'; %>
<% my $limit      = $c->stash->{limit} // 10; %>
<% my $addr_rows  = $c->stash->{addr_rows}  // []; %>
<% my $devices    = $c->stash->{devices}    // []; %>
<% my $interfaces = $c->stash->{interfaces} // []; %>
<% my $scopes     = $c->stash->{scopes}     // []; %>
<% my $edge_html  = $c->stash->{edge_html}; %>
<% my $fwt_html   = $c->stash->{fwt_html}; %>
<% my $arp_html   = $c->stash->{arp_html}; %>
<% my $attributes = $c->stash->{attributes} // []; %>
<% my $attr_add   = $c->stash->{attr_add}; %>
<h1><%= $title %></h1>

<h3>MAC Address</h3>
<table class="datatable detail">
  <tbody>
  % for my $r (@$addr_rows) {
  <tr><th><%= $r->[0] %></th><td><%== $r->[1] %></td></tr>
  % }
  </tbody>
</table>

% if (@$devices) {
<h3>Devices using this address</h3>
<table class="datatable">
  % for my $d (@$devices) {
    % my $l = Netdot::Mojo::Registry::link_for($d);
    % if ($l) {
  <tr><td><a href="<%= $l->[1] %>"><%= $l->[0] %></a></td></tr>
    % }
  % }
</table>
% }

% if (@$interfaces) {
<h3>Interfaces using this address</h3>
<table class="datatable">
  % for my $i (@$interfaces) {
    % my $l = Netdot::Mojo::Registry::link_for($i);
    % if ($l) {
  <tr><td><a href="<%= $l->[1] %>"><%= $l->[0] %></a></td></tr>
    % }
  % }
</table>
% }

% if ($edge_html) {
<h3>Edge Port</h3>
<table class="datatable"><thead><tr><th>Interface</th><th>Room</th><th>Jack</th><th>Description</th></tr></thead><tbody><%== $edge_html %></tbody></table>
% }

% if ($fwt_html) {
<h3>Last <%= $limit %> forwarding table entries</h3>
<table class="datatable"><%== $fwt_html %></table>
% }

% if ($arp_html) {
<h3>Last <%= $limit %> ARP entries</h3>
<table class="datatable"><%== $arp_html %></table>
% }

% if (@$scopes) {
<h3>DHCP Scopes</h3>
<table class="datatable">
  % for my $s (@$scopes) {
    % my $l = Netdot::Mojo::Registry::link_for($s);
    % if ($l) {
  <tr><td><a href="<%= $l->[1] %>"><%= $l->[0] %></a></td></tr>
    % }
  % }
</table>
% }

<h3>Custom Attributes</h3>
% if (@$attributes) {
<table class="datatable">
  <thead><tr><th>Name</th><th>Value</th></tr></thead>
  <tbody>
  % for my $a (@$attributes) {
  <tr><td><%= $a->[0] // '' %></td><td><%= $a->[1] // '' %></td></tr>
  % }
  </tbody>
</table>
% } else {
<p>No attributes.</p>
% }
% # Generic "Add" form (stashed by Physaddr#show, built by Detail::relation_adds):
% # the port of the legacy mac.html [add] link (edit.html?table=PhysAddrAttr&physaddr=<id>).
% if ($attr_add) {
<div style="margin-top:0.8em">
  <%= $c->render_to_string( template => 'management/_edit_form', layout => 0,
                            can_edit => 1, fields => $attr_add->{fields},
                            api_path => $c->web_prefix . '/api/' . $attr_add->{table},
                            nd_create => 1, nd_method => 'POST',
                            nd_label  => 'Add' ) %>
</div>
% }
