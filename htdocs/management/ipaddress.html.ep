% my $current    = $c->stash->{current};
% my $title      = $c->stash->{title}       // 'Ip';
% my $breadcrumb = $c->stash->{breadcrumb}  // [];
% my $attrs      = $c->stash->{attrs}       // [];
% my $comments   = $c->stash->{comments}    // '';
% my $a_records  = $c->stash->{a_records}   // [];
% my $ptr_records= $c->stash->{ptr_records} // [];
% my $services   = $c->stash->{services}    // [];
% my $attributes = $c->stash->{attributes}  // [];
% my $dhcp       = $c->stash->{dhcp}        // [];
% my $arp        = $c->stash->{arp}         // [];
% my $audit      = $c->stash->{audit}       // [];
% my $can_edit   = $c->stash->{can_edit};    # in-place edit
% my $can_delete = $c->stash->{can_delete};  # page-level delete (button)
% my $del_path   = $c->stash->{del_path}   // '';
% my $del_goto   = $c->stash->{del_goto}   // '';
% my $fields     = $c->stash->{fields}   // [];
% my $api_path   = $c->stash->{api_path} // '';
% my $ip_version = $c->stash->{ip_version} // 4;
%# Breadcrumb: Roots > a > b > (current, bold).
% if ($current) {
    <div class="breadcrumb" style="margin:0 0 1em 0; font-size:0.95em">
    % for my $i (0 .. $#$breadcrumb) {
        % my $cr = $breadcrumb->[$i];
        <a href="<%= $c->set_uri( $cr->{id} ? "/management/ipblock/$cr->{id}" : '/management/ipblock' ) %>"><%= $cr->{label} %></a>
        % if ($i < $#$breadcrumb) {
            <span style="color:#999"> » </span>
        % }
    % }
    <span style="color:#999"> » </span><strong><%= $current->get_label %></strong>
    </div>
% }
% my $add_types  = $c->stash->{add_types}  // [];
% if ( $can_edit && @$fields ) {
<button type="button" class="btn" id="nd-edit-toggle" style="margin:0 0 0.5em 0">Edit</button>
% }
% if ( $can_delete ) {
<button type="button" class="btn nd-rec-delete" data-nd-del="<%= $del_path %>" data-nd-goto="<%= $del_goto %>" data-nd-ipblock="1" data-nd-children="0" style="margin:0 0 0.5em 0.6em">Delete</button>
% }
<div class="container" id="nd-readonly">
  <div class="containerhead"><%= $title %></div>
  <div class="containerbody flat">
%# Fields: "General" look (datatable.detail c2, 2 pairs/row). Values are
%# pre-rendered HTML (may contain links) -> emitted unescaped.
% my $N    = 2;
% my @list = @$attrs;
    <table class="datatable detail c2">
      <tbody>
      % for (my $i = 0; $i < @list; $i += $N) {
      %   my $end = $i + $N - 1; $end = $#list if $end > $#list;
      %   my @r   = @list[$i .. $end];
      <tr>
        % for my $a (@r) {
        <th><%= $a->[0] %></th>
        <td><%== $a->[1] %></td>
        % }
      </tr>
      % }
      </tbody>
    </table>
  </div>
</div>

<%= $c->render_to_string( template => 'management/_edit_form', layout => 0,
                          can_edit => $can_edit, fields => $fields, api_path => $api_path ) %>

%# Comments
<div class="container">
    <div class="containerhead">Comments</div>
    <div class="containerbody" style="padding:0.6em">
<pre style="white-space:pre-wrap; margin:0"><%= $comments %></pre>
    </div>
</div>

%# DNS A records (hidden when empty)
% if (@$a_records) {
<div class="container">
    <div class="containerhead">DNS A Records</div>
    <div class="containerbody" style="padding:0.6em">
    <table class="datatable" style="width:100%">
        <thead><tr><th>Name</th><th>Zone</th></tr></thead>
        <tbody>
        % for my $r (@$a_records) {
            <tr>
                <td><%== $r->{name_html} %></td>
                <td>
                % if ($r->{zone_href}) {
                    <a href="<%= $r->{zone_href} %>"><%= $r->{zone} %></a>
                % } else {
                    <%= $r->{zone} %>
                % }
                </td>
            </tr>
        % }
        </tbody>
    </table>
    </div>
</div>
% }

%# DNS PTR records (hidden when empty)
% if (@$ptr_records) {
<div class="container">
    <div class="containerhead">DNS PTR Records</div>
    <div class="containerbody" style="padding:0.6em">
    <table class="datatable" style="width:100%">
        <thead><tr><th>Name</th><th>Zone</th></tr></thead>
        <tbody>
        % for my $r (@$ptr_records) {
            <tr>
                <td><%== $r->{name_html} %></td>
                <td>
                % if ($r->{zone_href}) {
                    <a href="<%= $r->{zone_href} %>"><%= $r->{zone} %></a>
                % } else {
                    <%= $r->{zone} %>
                % }
                </td>
            </tr>
        % }
        </tbody>
    </table>
    </div>
</div>
% }

%# Services
% if (@$services) {
<div class="container">
    <div class="containerhead">Services</div>
    <div class="containerbody" style="padding:0.6em">
    % if (!@$services) {
        <p style="color:#888">None.</p>
    % } else {
        <table class="datatable" style="width:100%">
            <thead><tr><th>Service</th><th>Contact List</th></tr></thead>
            <tbody>
            % for my $r (@$services) {
                <tr><td><%== $r->{service_html} %></td><td><%== $r->{contact_html} %></td></tr>
            % }
            </tbody>
        </table>
    % }
    </div>
</div>
% }

%# Custom Attributes
% if (@$attributes) {
<div class="container">
    <div class="containerhead">Custom Attributes</div>
    <div class="containerbody" style="padding:0.6em">
    % if (!@$attributes) {
        <p style="color:#888">None.</p>
    % } else {
        <table class="datatable" style="width:100%">
            <thead><tr><th>Name</th><th>Value</th></tr></thead>
            <tbody>
            % for my $r (@$attributes) {
                <tr><td><%= $r->{name} %></td><td><%= $r->{value} %></td></tr>
            % }
            </tbody>
        </table>
    % }
    </div>
</div>
% }

%# DHCP Host
% if (@$dhcp) {
<div class="container">
    <div class="containerhead">DHCP Host</div>
    <div class="containerbody" style="padding:0.6em">
    % if (!@$dhcp) {
        <p style="color:#888">None.</p>
    % } else {
        <table class="datatable" style="width:100%">
            <thead><tr><th>Type</th><th>Name</th><th>Ethernet</th><th>DUID</th><th>Active?</th></tr></thead>
            <tbody>
            % for my $r (@$dhcp) {
                <tr>
                    <td><%= $r->{type} %></td>
                    <td><%== $r->{name_html} %></td>
                    <td><%== $r->{ethernet_html} %></td>
                    <td><%= $r->{duid} %></td>
                    <td><%= $r->{active} ? 'Yes' : 'No' %></td>
                </tr>
            % }
            </tbody>
        </table>
    % }
    </div>
</div>
% }

%# Add a record (unified box, RR-page style): a type <select> reveals the matching
%# pre-rendered form; initForms POSTs collect(form) to data-nd-api. data-nd-int marks
%# FK id fields; collect() coerces purely-numeric values to integers (leaves names/
%# addresses as strings). Placed before the read-only ARP section.
% if ( $can_edit && @$add_types ) {
<div class="container">
    <div class="containerhead">Add a record</div>
    <div class="containerbody" style="padding:0.6em">
        <p style="margin-bottom:0.5em">
            Type:
            <select id="nd-add-type" class="nd-add-select">
                <option value="">-- Choose a record type --</option>
                % for my $t ( @$add_types ) {
                <option value="<%= $t->{type} %>"><%= $t->{label} %></option>
                % }
            </select>
        </p>
        % for my $t ( @$add_types ) {
        <form class="nd-rec-form nd-add-form" data-nd-type="<%= $t->{type} %>"
              data-nd-api="<%= $c->web_prefix %>/api/<%= $t->{type} %>"
              data-nd-method="POST" style="display:none;margin-top:0.5em">
            % for my $h ( sort keys %{ $t->{add}{hidden} } ) {
            <input type="hidden" name="<%= $h %>" value="<%= $t->{add}{hidden}{$h} %>" data-nd-int>
            % }
            <table class="datatable detail">
                <tbody>
                % for my $f ( @{ $t->{add}{fields} } ) {
                <tr>
                    <th><%= $f->{tag} %></th>
                    <td>
                        % if ( $f->{kind} eq 'number' ) {
                        <input type="number" name="<%= $f->{name} %>" value="<%= $f->{value} %>">
                        % } elsif ( $f->{kind} eq 'textarea' ) {
                        <textarea name="<%= $f->{name} %>" rows="2"><%= $f->{value} %></textarea>
                        % } elsif ( $f->{kind} eq 'readonly' ) {
                        <input type="text" value="<%= $f->{value} %>" disabled>
                        % } elsif ( $f->{kind} eq 'select' ) {
                        <select name="<%= $f->{name} %>" data-nd-int>
                            % unless ( $f->{value} ) {
                            <option value=""></option>
                            % }
                            % for my $opt ( @{ $f->{options} } ) {
                            <option value="<%= $opt->[0] %>"<%== ( $f->{value} && $opt->[0] == $f->{value} ) ? ' selected' : '' %>><%= $opt->[1] %></option>
                            % }
                        </select>
                        % } else {
                        <input type="text" name="<%= $f->{name} %>" value="<%= $f->{value} %>">
                        % }
                    </td>
                </tr>
                % }
                </tbody>
            </table>
            <p style="margin-top:0.4em">
                <button type="submit" class="btn">Add</button>
                <button type="button" class="btn nd-add-cancel" style="margin-left:0.5em">Cancel</button>
            </p>
        </form>
        % }
    </div>
</div>
% }

%# Last ARP entries
% if (@$arp) {
<div class="container">
    <div class="containerhead">Last ARP entries</div>
    <div class="containerbody" style="padding:0.6em">
        <table class="datatable" style="width:100%">
            <thead><tr><th>Time Seen</th><th>MAC</th><th>Interfaces</th></tr></thead>
            <tbody>
            % for my $r (@$arp) {
                <tr>
                    <td><%= $r->{tstamp} %></td>
                    <td><%== $r->{mac_html} %></td>
                    <td><%== join( ', ', @{ $r->{interfaces} } ) %></td>
                </tr>
            % }
            </tbody>
        </table>
    </div>
</div>
% }

%# Audit Records
% if (@$audit) {
<div class="container">
    <div class="containerhead">Audit Records</div>
    <div class="containerbody" style="padding:0.6em">
        <table class="datatable" style="width:100%">
            <thead><tr><th>Timestamp</th><th>Username</th><th>Table</th><th>Label</th><th>Operation</th></tr></thead>
            <tbody>
            % for my $r (@$audit) {
                <tr>
                    <td><%= $r->{tstamp} %></td>
                    <td><%= $r->{username} %></td>
                    <td><%= $r->{tablename} %></td>
                    <td><%= $r->{label} %></td>
                    <td><%= $r->{operation} %></td>
                </tr>
            % }
            </tbody>
        </table>
    </div>
</div>
% }
