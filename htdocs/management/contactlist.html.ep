% my $attrs     = $c->stash('attrs')     // [];
% my $contacts  = $c->stash('contacts')  // [];
% my $relations = $c->stash('relations') // [];
% my $dbase     = $c->set_uri( "/management/contactlist/" . ($c->stash('id') // '') );

<h1><%= $title %></h1>

<p>
  <a href="<%= url_for('contactlist_list') %>">&laquo; Contact List</a>
  % if ( $can_edit && @$fields ) {
  <button type="button" class="btn" id="nd-edit-toggle" style="margin-left:1.2em">Edit</button>
  % }
</p>

% if (@$attrs) {
%   # Fields: Device-Basics "General" look (datatable.detail, 2 pairs/row), no header.
%   my $N    = 2;
%   my @list = @$attrs;
  <table class="datatable detail c2" id="nd-readonly">
    <tbody>
    % for (my $i = 0; $i < @list; $i += $N) {
    %   my $end = $i + $N - 1; $end = $#list if $end > $#list;
    %   my @r   = @list[$i .. $end];
    <tr>
      % for my $a (@r) {
      %   my ( $tag, $text, $href ) = @$a;
      <th><%= $tag %></th>
      <td>
        % if ( defined $href ) {
        <a href="<%= $href %>"><%= $text %></a>
        % } else {
        <%= $text // '' %>
        % }
      </td>
      % }
    </tr>
    % }
    </tbody>
  </table>
% }

<%= $c->render_to_string( template => 'management/_edit_form', layout => 0,
                          can_edit => $can_edit, fields => $fields, api_path => $api_path ) %>

<div style="margin:1.2em 0 0.5em 0">
  <h2 style="font-size:1.05em; border-bottom:1px solid #ddeedd; padding-bottom:2px">Contacts (<%= scalar @$contacts %>)</h2>
  % if (@$contacts) {
  <table class="datatable">
    <thead>
      <tr>
        <th>Person</th>
        <th>Contact Type</th>
        <th>Email</th>
        <th>Pager</th>
        <th>Voice</th>
        <th>Escalation</th>
      </tr>
    </thead>
    <tbody>
      % for my $r (@$contacts) {
      <tr>
        <td>
          % if ($r->{person}[1]) {
          <a href="<%= $r->{person}[1] %>"><%= $r->{person}[0] %></a>
          % } else {
          <%= $r->{person}[0] %>
          % }
        </td>
        <td><%= $r->{contacttype} %></td>
        <td><%= $r->{notify_email} %></td>
        <td><%= $r->{notify_pager} %></td>
        <td><%= $r->{notify_voice} %></td>
        <td><%= $r->{escalation_level} %></td>
      </tr>
      % }
    </tbody>
  </table>
  % } else {
  <p>No contacts.</p>
  % }
</div>

% for my $r (@$relations) {
<div style="margin:1.2em 0 0.5em 0">
  <h2 style="font-size:1.05em; border-bottom:1px solid #ddeedd; padding-bottom:2px"><%= $r->{title} %></h2>
  <table class="datatable">
    <thead>
      <tr>
      % for my $h ( @{ $r->{cols} } ) {
      <th><%= $h %></th>
      % }
      </tr>
    </thead>
    <tbody>
      % for my $row ( @{ $r->{rows} } ) {
      <tr>
        % for my $cell ( @$row ) {
        % my ($t, $h) = @$cell;
        <td>
          % if ($h) {
          <a href="<%= $h %>"><%= $t %></a>
          % } else {
          <%= $t // '' %>
          % }
        </td>
        % }
      </tr>
      % }
    </tbody>
  </table>
  <p style="font-size:0.85em; margin:0.3em 0 0 0">
    % if ( $r->{total} > $r->{per} ) {
    Results: [<%= $r->{start} %>-<%= $r->{last_item} %>] of <%= $r->{total} %>&nbsp;
    % if ( $r->{offset} > 0 ) {
    <a href="<%= $r->{offset} >= $r->{per} ? ( $dbase . '?offset=' . ( $r->{offset} - $r->{per} ) ) : $dbase %>">&laquo;</a>&nbsp;
    % }
    % if ( $r->{offset} + $r->{per} < $r->{total} ) {
    <a href="<%= $dbase . '?offset=' . ( $r->{offset} + $r->{per} ) %>">&raquo;</a>
    % }
    &nbsp;
    % }
    <a href="<%= $dbase . '?csv=' . $r->{csv_rel} %>">[csv]</a>
  </p>
</div>
% }
