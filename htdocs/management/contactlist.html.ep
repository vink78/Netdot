% my $attrs     = $c->stash('attrs')     // [];
% my $contacts  = $c->stash('contacts')  // [];
% my $relations = $c->stash('relations') // [];
% my $dbase     = $c->set_uri( "/management/contactlist/" . ($c->stash('id') // '') );

<h1><%= $title %></h1>

<p>
  <a href="<%= url_for('contactlist_list') %>">&laquo; Contact List</a>
  % if ( $can_edit && @$fields ) {
  <button type="button" class="btn" id="nd-edit-toggle" style="margin-left:1.2em">Edit</button>
  % }
</p>

% if (@$attrs) {
%   # Fields: Device-Basics "General" look (datatable.detail, 2 pairs/row), no header.
%   my $N    = 2;
%   my @list = @$attrs;
  <table class="datatable detail c2" id="nd-readonly">
    <tbody>
    % for (my $i = 0; $i < @list; $i += $N) {
    %   my $end = $i + $N - 1; $end = $#list if $end > $#list;
    %   my @r   = @list[$i .. $end];
    <tr>
      % for my $a (@r) {
      %   my ( $tag, $text, $href ) = @$a;
      <th><%= $tag %></th>
      <td>
        % if ( defined $href ) {
        <a href="<%= $href %>"><%= $text %></a>
        % } else {
        <%= $text // '' %>
        % }
      </td>
      % }
    </tr>
    % }
    </tbody>
  </table>
% }

<%= $c->render_to_string( template => 'management/_edit_form', layout => 0,
                          can_edit => $can_edit, fields => $fields, api_path => $api_path ) %>

<div style="margin:1.2em 0 0.5em 0">
  <h2 style="font-size:1.05em; border-bottom:1px solid #ddeedd; padding-bottom:2px">Contacts (<%= scalar @$contacts %>)</h2>
  % if (@$contacts) {
  % # Row write affordances: Edit reveals the row's in-table form (PATCH
  % # /api/contact/<id>). A contact row is the role link itself (a Person is
  % # not deleted), so the row control is a Remove (DELETE /api/contact/<id>;
  % # netdot.js initRowRemoves); the API re-checks the per-object right.
  % my $row_act = ( $contact_can_edit || $contact_can_del ) ? 1 : 0;
  <table class="datatable">
    <thead>
      <tr>
        <th>Person</th>
        <th>Contact Type</th>
        <th>Email</th>
        <th>Pager</th>
        <th>Voice</th>
        <th>Escalation</th>
        % if ($row_act) {
        <th></th>
        % }
      </tr>
    </thead>
    <tbody>
      % for my $r (@$contacts) {
      <tr class="nd-row-ro">
        <td>
          % if ($r->{person}[1]) {
          <a href="<%= $r->{person}[1] %>"><%= $r->{person}[0] %></a>
          % } else {
          <%= $r->{person}[0] %>
          % }
        </td>
        <td><%= $r->{contacttype} %></td>
        <td><%= $r->{notify_email} %></td>
        <td><%= $r->{notify_pager} %></td>
        <td><%= $r->{notify_voice} %></td>
        <td><%= $r->{escalation_level} %></td>
        % if ( $row_act && $r->{id} ) {
        <td class="nd-row-act">
          % if ( $contact_can_edit ) {
          <button type="button" class="btn nd-row-edit">Edit</button>
          % }
          % if ( $contact_can_del ) {
          <button type="button" class="btn nd-row-remove"
                  data-nd-remove="row"
                  data-nd-del="<%= $c->web_prefix . '/api/contact/' . $r->{id} %>"
                  data-nd-type="contact"
                  style="margin-left:0.4em">Remove</button>
          % }
        </td>
        % }
      </tr>
      % if ( $contact_can_edit && $r->{id} && $r->{edit_fields} ) {
      <tr class="nd-row-form" style="display:none">
        <td colspan="<%= $row_act ? 7 : 6 %>">
          <%= $c->render_to_string( template => 'management/_edit_form', layout => 0,
                                    can_edit => 1, fields => $r->{edit_fields},
                                    api_path => $c->web_prefix . '/api/contact/' . $r->{id},
                                    nd_method => 'PATCH', nd_row => 1 ) %>
        </td>
      </tr>
      % }
      % }
    </tbody>
  </table>
  % } else {
  <p>No contacts.</p>
  % }
  % # Generic "Add" form (stashed by Contactlist#show, built by
  % # Detail::relation_adds): the port of the legacy [add] link on the Contacts
  % # section (edit.html?table=Contact&contactlist=<id>). POST /api/contact;
  % # the parent contactlist is a hidden pre-filled field.
  % if ( my $ca = $c->stash('contact_add') ) {
  <div style="margin-top:0.8em">
    <%= $c->render_to_string( template => 'management/_edit_form', layout => 0,
                              can_edit => 1, fields => $ca->{fields},
                              api_path => $c->web_prefix . '/api/' . $ca->{table},
                              nd_create => 1, nd_method => 'POST',
                              nd_label  => 'Add' ) %>
  </div>
  % }
</div>

% for my $r (@$relations) {
% # Relation table + row write affordances (Edit / Remove / Delete per row —
% # shared partial, see _relation_table.html.ep).
<div style="margin:1.2em 0 0.5em 0">
  <h2 style="font-size:1.05em; border-bottom:1px solid #ddeedd; padding-bottom:2px"><%= $r->{title} %></h2>
  <%= $c->render_to_string( template => 'management/_relation_table', layout => 0, r => $r ) %>
  <p style="font-size:0.85em; margin:0.3em 0 0 0">
    % if ( $r->{total} > $r->{per} ) {
    Results: [<%= $r->{start} %>-<%= $r->{last_item} %>] of <%= $r->{total} %>&nbsp;
    % if ( $r->{offset} > 0 ) {
    <a href="<%= $r->{offset} >= $r->{per} ? ( $dbase . '?offset=' . ( $r->{offset} - $r->{per} ) ) : $dbase %>">&laquo;</a>&nbsp;
    % }
    % if ( $r->{offset} + $r->{per} < $r->{total} ) {
    <a href="<%= $dbase . '?offset=' . ( $r->{offset} + $r->{per} ) %>">&raquo;</a>
    % }
    &nbsp;
    % }
    <a href="<%= $dbase . '?csv=' . $r->{csv_rel} %>">[csv]</a>
  </p>
</div>
% }
