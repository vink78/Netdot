<%# Device detail: read-only port of device.html (Basics + Interfaces views). %>
<% my $id     = $c->stash->{id} // ''; %>
<% my $view   = $c->stash->{view} // 'Basics'; %>
<% my $fqdn   = $c->stash->{fqdn} // ''; %>
<% my $title  = $c->stash->{title} // 'Device'; %>
<% my $base   = $c->set_uri( "/management/device/$id" ); %>
<% my $can_delete = $c->stash('can_delete'); %>
<% my $del_path   = $c->stash('del_path') // ''; %>
<% my $del_goto   = $c->stash('del_goto') // ''; %>
<% my $can_discover = $c->stash('can_discover'); %>

<h1><%= $title %></h1>
<p>
  <b><%= $fqdn %></b>
  <a href="http://<%= $fqdn %>" target="_blank">[HTTP]</a>
  <a href="https://<%= $fqdn %>" target="_blank">[HTTPS]</a>
  <a href="<%= $base %>">[refresh]</a>
  % if ( $can_delete ) {
  <button type="button" class="btn nd-rec-delete" data-nd-del="<%= $del_path %>" data-nd-goto="<%= $del_goto %>" data-nd-device="1" style="margin-left:1.2em">Delete</button>
  % }
  % if ( $can_discover ) {
  % # SNMP re-poll of this device (stored credentials, admin only).
  <a class="btn" href="<%= $c->url_for( 'device_update', id => $id )->to_string %>" style="margin-left:1.2em">SNMP update</a>
  % }
</p>

% my @tabs = (
%   [ 'Basics',     'Basics' ],
%   [ 'Interfaces', 'Interfaces' ],
%   [ 'IP',         'IP' ],
%   [ 'BGP',        'BGP' ],
%   [ 'Hosted',     'Hosted' ],
%   [ 'Circuits',   'Circuits' ],
%   [ 'STP',        'STP' ],
%   [ 'Topology',   'Topology' ],
% );
% # ARP / FWT tabs: only when the device has data (Mason: conditional).
% push @tabs, [ 'ARP', 'ARP' ] if $c->stash->{has_arp};
% push @tabs, [ 'FWT', 'FWT' ] if $c->stash->{has_fwt};
% push @tabs, [ 'Modules', 'Modules' ];
% push @tabs, [ 'Audit',   'Audit'   ];
% # Access Rights tab: only for users who may view the section (Mason:
% # access_section 'device.html:edit_rights' => Admin/Operator).
% push @tabs, [ 'Rights', 'Access Rights' ] if $c->stash->{show_rights};
<div class="tabcard">
<div class="tabbar">
% for my $i (0 .. $#tabs) {
    % my $t = $tabs[$i];
    <a class="tab<%= $view eq $t->[0] ? ' active' : '' %>"
       hx-boost="false"
       href="<%= $base %>?view=<%= $t->[0] %>"><%= $t->[1] %></a>
% }
</div>
<div class="tabcard-body">
% if ($view eq 'Basics') {
% my $sections = $c->stash->{sections} // [];
% if ( $can_edit && @$fields ) {
<button type="button" class="btn" id="nd-edit-toggle" style="margin:0 0 0.5em 0">Edit</button>
% }
<div id="nd-readonly">
% for my $s (@$sections) {
% my $rows = $s->{rows};
% next unless @$rows;
<div class="container boxed">
  <div class="containerhead"><%= $s->{title} %></div>
  <div class="containerbody flat">
    <table class="datatable detail c<%= $s->{cols} %>">
      <tbody>
      % for my $row (@$rows) {
      <tr>
        % for my $cell (@$row) {
          % my ( $tag, $text, $href ) = @$cell;
          % my $wide = ( !defined $tag || $tag eq '' );
          % if ($wide) {
          <td colspan="2">
          % } else {
          <th><%= $tag %></th>
          <td>
          % }
            % if ( ref $text eq 'ARRAY' ) {
            % for my $li (0 .. $#$text) {
            % my $l = $text->[$li];
            % if ($li > 0) {
            ,
            % }
            % if ( $l->[1] ) {
            <a href="<%= $l->[1] %>"><%= $l->[0] %></a>
            % } else {
            <%= $l->[0] %>
            % }
            % }
            % } else {
            % if ( defined $href ) {
            <a href="<%= $href %>"><%= $text // '' %></a>
            % } else {
            <%= $text // '' %>
            % }
            % }
          </td>
        % }
      </tr>
      % }
      </tbody>
    </table>
  </div>
</div>
% }
</div>
% # Custom-attributes "Add" form (stashed by Device#show, built by
% # Detail::relation_adds): the port of the legacy device.html [add] link on
% # the Custom Attributes section (edit.html?table=DeviceAttr&device=<id>).
% # Custom Attributes is the last Basics section, so this sits directly below it.
% if ( $c->stash('attr_add') ) {
<div style="margin-top:0.8em">
  <%= $c->render_to_string( template => 'management/_edit_form', layout => 0,
                            can_edit => 1, fields => $c->stash('attr_add')->{fields},
                            api_path => $c->web_prefix . '/api/' . $c->stash('attr_add')->{table},
                            nd_create => 1, nd_method => 'POST',
                            nd_label  => 'Add' ) %>
</div>
% }
<%= $c->render_to_string( template => 'management/_edit_form', layout => 0,
                          can_edit => $can_edit, fields => $fields, api_path => $api_path ) %>
% }
% elsif ($view eq 'Interfaces') {
% my $rows      = $c->stash->{rows}      // [];
% my $vids      = $c->stash->{vids}      // [];
% my $showvlan  = $c->stash->{showvlan}  // 'all';
% my $show_jack = $c->stash->{show_jack} // 0;
% my $show_desc = $c->stash->{show_desc} // 0;
% my $sort_base = $c->stash->{sort_base} // $base;
% my $editints  = $c->stash->{editints}  // 0;
% my $ifsort    = $c->stash->{ifsort}    // 'number';
% my $jack_opts = $c->stash->{jack_opts} // [];
% my $jack_kw   = $c->stash->{jack_kw}   // 0;
% my $api_base  = $c->web_prefix . '/api';
% my $edit_url  = $base . '?view=Interfaces&ifsort=' . $ifsort;
<div style="margin:0.5em 0; font-size:0.9em">
  <form method="get" action="<%= $base %>" style="display:inline">
    <input type="hidden" name="view" value="Interfaces">
    VLAN:
    <select name="showvlan" onchange="this.form.submit()">
      <option value="all"<%= $showvlan eq 'all' ? ' selected' : '' %>>all</option>
      % for my $v (@$vids) {
      <option value="<%= $v %>"<%= $showvlan eq $v ? ' selected' : '' %>><%= $v %></option>
      % }
    </select>
  </form>
  &nbsp;&nbsp; Legend:
  <span style="background-color:#cccccc">manual</span>
  <span style="background-color:#ff8e8e">removed</span>
  % if ( $can_edit && !$editints ) {
  &nbsp;&nbsp;<a class="btn" href="<%= $edit_url %>&amp;editints=1">Edit</a>
  % }
</div>
% if ($editints) {
% # Mason's ?editints=1: the whole table becomes editable; saving goes through
% # the JSON API (netdot.js initIntEdit: PATCH /api/interface/<id> per dirty
% # row, ONE DELETE /api/interface?id=… for the checked rows).
<form class="nd-if-edit" data-nd-api-base="<%= $api_base %>">
% }
% my @cols;
% if ($editints) {
%   # Edit mode: [del] + the editable fields only, plain headers (Mason).
%   @cols = ( [ 'del',    undef,     undef    ],
%             [ 'number', 'Number',  undef    ],
%             [ 'name',   'Name',    undef    ],
%             [ 'jack',   'Jack',    undef    ],
%             [ 'descr',  'Descr.',  undef    ],
%             [ 'conn',   'Connected', undef  ] );
% } else {
%   @cols = (
%     [ 'number', 'Number', 'number' ],
%     [ 'name',   'Name',   'name'   ],
%     [ 'speed',  'Speed',  'speed'  ],
%     [ 'vlans',  'VLAN',   'vlan'   ],
%     [ 'status', 'Status', 'oper_status' ],
%   );
%   push @cols, [ 'jack',  'Jack',  'jack'  ] if $show_jack;
%   push @cols, [ 'descr', 'Descr.','descr' ] if $show_desc;
%   push @cols, [ 'conn',  'Connected Devices', undef ];
% }
<table class="datatable sortable">
  <thead>
    <tr>
    % for my $col (@cols) {
      % my ($key, $label, $skey) = @$col;
      % if ($skey) {
      <th><a href="<%= $sort_base %>&amp;ifsort=<%= $skey %>"><%= $label %></a></th>
      % } else {
      <th><%= $label %></th>
      % }
    % }
    </tr>
  </thead>
  <tbody>
    % for my $r (@$rows) {
    % if ($r->{style}) {
    <tr data-nd-if="<%= $r->{id} %>" style="<%= $r->{style} %>">
    % } else {
    <tr data-nd-if="<%= $r->{id} %>">
    % }
      % if ($editints) {
      % my $edit = $r->{edit} || {};
      % my $jval = defined $edit->{jack} ? $edit->{jack} : '';
      <td><input type="checkbox" class="nd-if-del"></td>
      <td><input type="text" data-nd-f="number" data-nd-orig="<%= $edit->{number} // '' %>" value="<%= $edit->{number} // '' %>" style="width:5em"></td>
      <td><input type="text" data-nd-f="name" data-nd-orig="<%= $edit->{name} // '' %>" value="<%= $edit->{name} // '' %>" style="width:10em"></td>
      <td>
        % if ($jack_kw) {
        % # Many (or no) closet jacks: keyword search + select (nd-fk-search),
        % # like the detail edit form's large-FK picker.
        <span class="nd-fk-search">
          <input type="text" class="nd-fk-kw" placeholder="Search…" data-nd-target="horizontalcable" data-nd-max="100">
          <button type="button" class="btn nd-fk-go">List</button>
          <select class="nd-fk-select" data-nd-f="jack" data-nd-orig="<%= $jval %>">
            <option value="">-- Search --</option>
            % if ( defined $edit->{jack} ) {
            <option value="<%= $jval %>" selected><%= $edit->{jack_label} // '#' . $jval %></option>
            % }
            <option value="">[null]</option>
          </select>
        </span>
        % } else {
        <select data-nd-f="jack" data-nd-orig="<%= $jval %>">
          <option value="">[null]</option>
          % for my $jo (@$jack_opts) {
          <option value="<%= $jo->[0] %>"<%= ( $jval ne '' && $jval eq $jo->[0] ) ? ' selected' : '' %>><%= $jo->[1] %></option>
          % }
        </select>
        % }
      </td>
      <td><input type="text" data-nd-f="description" data-nd-orig="<%= $edit->{description} // '' %>" value="<%= $edit->{description} // '' %>"></td>
      <td>
        % # Connected Device picker: keyword search over all interfaces
        % # (?kw= via the generic API) + select; saving sends `neighbor`
        % # (id or null) through the row's PATCH (initIntEdit).
        <span class="nd-fk-search">
          <input type="text" class="nd-fk-kw" placeholder="Search…" data-nd-target="interface" data-nd-max="100">
          <button type="button" class="btn nd-fk-go">List</button>
          <select class="nd-fk-select" data-nd-f="neighbor" data-nd-orig="<%= $edit->{neighbor} // '' %>">
            <option value="">-- Search --</option>
            % if ( defined $edit->{neighbor} ) {
            <option value="<%= $edit->{neighbor} %>" selected><%= $edit->{neighbor_label} // '#' . $edit->{neighbor} %></option>
            % }
            <option value="">[null]</option>
          </select>
        </span>
      </td>
      % } else {
      % for my $col (@cols) {
      % my $key  = $col->[0];
      % my $segs = $r->{$key};
      <td>
        % if ( ref $segs eq 'HASH' && $segs->{select} ) {
        <select onchange="location.href=this.value">
        % for my $oi (0 .. ( @{ $segs->{options} } - 1 )) {
        % my ($ot, $oh) = @{ $segs->{options}[$oi] };
        <option value="<%= $oh %>"<%= $oi == 0 ? ' selected' : '' %>><%= $ot %></option>
        % }
        </select>
        % } else {
        % for my $i (0 .. $#$segs) {
          % my ($t, $h) = @{ $segs->[$i] };
          % if ($h) {
          <a href="<%= $h %>"><%= $t %></a>
          % } else {
          <%= $t %>
          % }
          % if ($i < $#$segs) {
          <br>
          % }
        % }
        % }
      </td>
      % }
      % }
    </tr>
    % }
  </tbody>
</table>
% if ($editints) {
  <p style="margin:0.8em 0 0">
    <button type="button" class="btn nd-if-save">Save</button>
    <a class="btn" href="<%= $edit_url %>">Cancel</a>
    &nbsp;&nbsp;<span style="color:#666;font-size:0.85em">Checked rows are deleted; unchanged fields are not sent.</span>
  </p>
</form>
% }
% # Mason's Interfaces-tab "Options" box (shown when not in edit mode and the
% # user may edit the device): "Manually Add N interfaces" (POST
% # /api/device/<id>/add_interfaces) and "SNMP Updates Overwrite Descriptions"
% # (POST /api/device/<id>/overwrite_if_descr; the "Yes" case confirms in JS).
% if ( $can_edit && !$editints ) {
<div class="container" style="margin-top:0.8em">
  <div class="containerhead">Options</div>
  <div class="containerbody">
    <p>
      <form class="nd-add-interfaces" data-nd-api-base="<%= $api_base %>" data-nd-id="<%= $id %>" style="display:inline">
        Manually
        <input type="submit" class="btn" value="Add">
        <input type="number" name="num" value="1" min="1" step="1" size="3" style="width:4em"> interfaces
      </form>
    </p>
    <p>
      <form class="nd-dev-act" data-nd-action="overwrite_if_descr" data-nd-api-base="<%= $api_base %>" data-nd-id="<%= $id %>" style="display:inline">
        SNMP Updates Overwrite Descriptions:
        <select name="value">
          <option value="" selected>--Select--</option>
          <option value="0">No</option>
          <option value="1">Yes</option>
        </select>
        <input type="submit" class="btn" value="Set">
      </form>
    </p>
  </div>
</div>
% }
% }
% elsif ($view eq 'IP') {
% # Device IP view (port of device.html "IP" section): display + edit (editips)
% # + add IP (add_ip) + DNS options. Writes go through the JSON API:
% #   row save  -> PATCH /api/ipblock/<id>  (interface / monitored)
% #   row/cell  -> DELETE /api/{ipblock,rr,ipservice}?id=…
% #   add IP    -> POST /api/device/<id>/add_ip
% #   add svc   -> POST /api/ipservice
% #   auto DNS  -> POST /api/device/<id>/auto_dns | /regen_dns
% my $rows       = $c->stash->{rows}       // [];
% my $sort_base  = $c->stash->{sort_base}  // $base;
% my $sort       = $c->stash->{sort}       // 'address';
% my $empty_msg  = $c->stash->{empty_msg}  // 'No data.';
% my $can_edit   = $c->stash->{can_edit}   // 0;
% my $editips    = $c->stash->{editips}    // 0;
% my $add_ip     = $c->stash->{add_ip}     // 0;
% my $int_opts   = $c->stash->{int_opts}   // [];
% my $svc_opts   = $c->stash->{svc_opts}   // [];
% my $cl_opts    = $c->stash->{cl_opts}    // [];
% my $cl_def     = $c->stash->{cl_def};
% my $api_base   = $c->web_prefix . '/api';
% my $ip_url     = $base . '?view=IP&ipsort=' . $sort;

% if ( $can_edit && !$editips && !$add_ip ) {
<div style="margin:0.5em 0; font-size:0.9em">
  <a class="btn" href="<%= $ip_url %>&amp;editips=1">Edit</a>
  <a class="btn" href="<%= $ip_url %>&amp;add_ip=1">Add</a>
</div>
% }

% if ($editips) {
% # Mason's ?editips=1: per-IP delete, interface select, per-RR / per-service
% # delete checkboxes, monitored checkbox; saving goes through the JSON API
% # (initIntEdit, data-nd-table="ipblock").
<form class="nd-if-edit" data-nd-table="ipblock" data-nd-api-base="<%= $api_base %>">
% }
% if (!@$rows) {
<p style="color:#666"><i><%= $empty_msg %></i></p>
% } else {
<table class="datatable sortable">
  <thead>
    <tr>
    % if ($editips) {
    <th></th>
    % }
    <th><a href="<%= $sort_base %>&amp;ipsort=address">Address</a></th>
    <th>Subnet</th>
    <th><a href="<%= $sort_base %>&amp;ipsort=interface">Interface</a></th>
    <th>DNS Name(s)</th>
    <th>Monitored?</th>
    <th>Services</th>
    </tr>
  </thead>
  <tbody>
    % for my $row (@$rows) {
    <tr data-nd-if="<%= $row->{id} %>">
      % if ($editips) {
      <td><input type="checkbox" class="nd-if-del" data-nd-del="ipblock"></td>
      <td><%= $row->{address}[0] %></td>
      <td><%= $row->{subnet}[0] %></td>
      <td>
        % my $ival = defined $row->{iface_id} ? $row->{iface_id} : '';
        <select class="nd-fk-select" data-nd-f="interface" data-nd-orig="<%= $ival %>">
          <option value="">[null]</option>
          % for my $io (@$int_opts) {
          <option value="<%= $io->[0] %>"<%= ( $ival ne '' && $ival eq $io->[0] ) ? ' selected' : '' %>><%= $io->[1] %></option>
          % }
        </select>
      </td>
      <td>
        % for my $d (@{ $row->{dns} }) {
        % if ($d->{deletable}) {
        <input type="checkbox" class="nd-cell-del" data-nd-del="rr" data-nd-id="<%= $d->{id} %>" title="Delete this DNS name">
        % }
        <a href="<%= $d->{href} %>"><%= $d->{label} %></a><br>
        % }
      </td>
      <td><input type="checkbox" data-nd-f="monitored" data-nd-orig="<%= $row->{monitored} %>"<%= $row->{monitored} ? ' checked' : '' %></td>
      <td>
        % for my $s (@{ $row->{services} }) {
        <input type="checkbox" class="nd-cell-del" data-nd-del="ipservice" data-nd-id="<%= $s->{id} %>" title="Delete this service">
        <a href="<%= $s->{href} %>"><%= $s->{name} %></a><br>
        % }
      </td>
      % } else {
      <td><a href="<%= $row->{address}[1] %>"><%= $row->{address}[0] %></a></td>
      % if ($row->{subnet}[1]) {
      <td><a href="<%= $row->{subnet}[1] %>"><%= $row->{subnet}[0] %></a></td>
      % } else {
      <td><%= $row->{subnet}[0] %></td>
      % }
      % if ($row->{iface}[1]) {
      <td><a href="<%= $row->{iface}[1] %>"><%= $row->{iface}[0] %></a></td>
      % } else {
      <td><%= $row->{iface}[0] %></td>
      % }
      <td>
        % for my $d (@{ $row->{dns} }) {
        <a href="<%= $d->{href} %>"><%= $d->{label} %></a><br>
        % }
      </td>
      <td><%= $row->{monitored} ? 'yes' : 'no' %></td>
      <td>
        % for my $s (@{ $row->{services} }) {
        <a href="<%= $s->{href} %>"><%= $s->{name} %></a><br>
        % }
        % if ($can_edit) {
        % # Inline port of Mason's addservice.html popup.
        <a class="hand nd-svc-toggle" href="#">[add]</a>
        <div class="nd-svc-form" style="display:none">
          <form class="nd-if-svc" data-nd-ip="<%= $row->{id} %>" data-nd-api-base="<%= $api_base %>">
            <select name="service">
              <option value="">-- Service --</option>
              % for my $so (@$svc_opts) {
              <option value="<%= $so->[0] %>"><%= $so->[1] %></option>
              % }
            </select>
            <label><input type="checkbox" name="monitored" value="1" checked>mon.</label>
            <select name="contactlist">
              <option value="">-- Contact --</option>
              % for my $clo (@$cl_opts) {
              <option value="<%= $clo->[0] %>"<%= ( defined $cl_def && $cl_def == $clo->[0] ) ? ' selected' : '' %>><%= $clo->[1] %></option>
              % }
            </select>
            <button type="submit" class="btn">Add</button>
          </form>
        </div>
        % }
      </td>
      % }
    </tr>
    % }
  </tbody>
</table>
% }
% if ($editips) {
  <p style="margin:0.8em 0 0">
    <button type="button" class="btn nd-if-save">Save</button>
    <a class="btn" href="<%= $ip_url %>">Cancel</a>
    &nbsp;&nbsp;<span style="color:#666;font-size:0.85em">Checked rows are deleted; unchanged fields are not sent.</span>
  </p>
</form>
% }
% if ($add_ip) {
% # Mason's ?add_ip=1: add an IP address to the device (POST /api/device/<id>/add_ip).
<form class="nd-add-ip" data-nd-api-base="<%= $api_base %>" data-nd-id="<%= $id %>">
  <table class="datatable">
    <tr><th>Address</th><th>Interface</th></tr>
    <tr>
      <td><input type="text" name="address" style="width:15em" placeholder="1.2.3.4 or 2001:db8::1"></td>
      <td>
        <select name="interface">
          <option value="">Select Interface</option>
          % for my $io (@$int_opts) {
          <option value="<%= $io->[0] %>"><%= $io->[1] %></option>
          % }
        </select>
      </td>
    </tr>
  </table>
  <p style="margin:0.8em 0 0">
    <button type="submit" class="btn">Add</button>
    <a class="btn" href="<%= $ip_url %>">Cancel</a>
  </p>
</form>
% }
% if ($can_edit && !$editips && !$add_ip) {
% # Mason's "DNS Options" box (two small actions on the device).
<div class="container" style="margin-top:0.8em">
  <div class="containerhead">DNS Options</div>
  <div class="containerbody">
    <p style="margin:0.3em 0">
      <form class="nd-dev-act" data-nd-action="auto_dns" data-nd-api-base="<%= $api_base %>" data-nd-id="<%= $id %>" style="display:inline">
        Set Auto DNS on all IP interfaces to:
        <select name="value">
          <option value="" selected>--Select--</option>
          <option value="0">No</option>
          <option value="1">Yes</option>
        </select>
        <button type="submit" class="btn">Set</button>
      </form>
    </p>
    <p style="margin:0.3em 0">
      <form class="nd-dev-act" data-nd-action="regen_dns" data-nd-api-base="<%= $api_base %>" data-nd-id="<%= $id %>" style="display:inline">
        Re-generate DNS names for all IPs
        <button type="submit" class="btn">Go</button>
      </form>
    </p>
  </div>
</div>
% }
% }
% elsif ($view eq 'BGP') {
% # Device BGP view (port of device.html "BGP" section): the "Device BGP Info"
% # attribute box (bgpid + local AS number, editable via ?editdevbgp=1) and the
% # BGP Peers table (editable via ?editbgp=1: per-peer remote IP, monitored,
% # contact list -> PATCH /api/bgppeer/<id>; the info box PATCHes /api/device/<id>
% # and /api/asn/<id> — netdot.js initBgpInfo).
% my $rows       = $c->stash->{rows}       // [];
% my $sort_base  = $c->stash->{sort_base}  // $base;
% my $sort       = $c->stash->{sort}       // 'ip';
% my $can_edit   = $c->stash->{can_edit}   // 0;
% my $editbgp    = $c->stash->{editbgp}    // 0;
% my $editdevbgp = $c->stash->{editdevbgp} // 0;
% my $bgpid      = $c->stash->{bgpid}      // '';
% my $localas    = $c->stash->{localas};
% my $cl_opts    = $c->stash->{cl_opts}    // [];
% my $empty_msg  = $c->stash->{empty_msg}  // 'No data.';
% my $api_base   = $c->web_prefix . '/api';
% my $bgp_url    = $base . '?view=BGP&peersort=' . $sort;

<div class="container">
  <div class="containerhead">Device BGP Info</div>
  <div class="containerbody">
  % if ($editdevbgp) {
  % # Mason's ?editdevbgp=1: bgpid (PATCH /api/device/<id>) and the local AS
  % # number (PATCH /api/asn/<id>: the number column of the linked ASN object,
  % # exactly as Mason). netdot.js initBgpInfo sends one PATCH per changed field.
  <form class="nd-bgp-info" data-nd-api-base="<%= $api_base %>" data-nd-id="<%= $id %>"
        data-nd-asn-id="<%= $localas ? $localas->{id} : '' %>">
    <table class="datatable detail">
      <tbody>
      <tr><th>BGP ID</th><td><input type="text" name="bgpid" value="<%= $bgpid %>" data-nd-orig="<%= $bgpid %>" style="width:15em"></td></tr>
      % if ($localas) {
      <tr><th>Local AS</th><td><input type="text" name="localas" value="<%= $localas->{number} %>" data-nd-orig="<%= $localas->{number} %>" style="width:12em"></td></tr>
      % } else {
      <tr><th>Local AS</th><td>n/a</td></tr>
      % }
      </tbody>
    </table>
    <p style="margin:0.8em 0 0">
      <button type="submit" class="btn">Save</button>
      <a class="btn" href="<%= $bgp_url %>">Cancel</a>
    </p>
  </form>
  % } else {
    <p style="font-size:0.9em">
      % if (length $bgpid) {
      <b>BGP ID:</b> <%= $bgpid %>&nbsp;&nbsp;&nbsp;
      % }
      % if ($localas) {
      <b>Local AS:</b>
      % if ($localas->{href}) {
      <a href="<%= $localas->{href} %>"><%= $localas->{number} %></a>
      % } else {
      <%= $localas->{number} %>
      % }
      % } else {
      <b>Local AS:</b> n/a
      % }
    </p>
    % if ($can_edit) {
    <div style="margin:0.5em 0; font-size:0.9em">
      <a class="btn" href="<%= $bgp_url %>&amp;editdevbgp=1">Edit</a>
    </div>
    % }
  % }
  </div>
</div>

% # BGP Peers (Mason shows the box when peers exist; the [Add] button needs it
% # also when the list is empty). Edit mode: per-peer remote IP / monitored /
% # contact list (PATCH /api/bgppeering/<id>) + row delete; add mode: POST
% # /api/bgppeering (Mason: peers come from the SNMP poll, manual add on top).
% my $npeers   = scalar grep { ref($_) eq 'HASH' && !defined $_->{section} } @$rows;
% my $addpeer  = $c->stash->{addpeer}  // 0;
% my $ent_opts = $c->stash->{ent_opts} // [];
<div class="container">
  <div class="containerhead">BGP Peers</div>
  <div class="containerbody">
  % if ($can_edit && !$editbgp && !$addpeer) {
  <div style="margin:0.5em 0; font-size:0.9em">
    % if ($npeers) {
    <a class="btn" href="<%= $bgp_url %>&amp;editbgp=1">Edit</a>
    % }
    <a class="btn" href="<%= $bgp_url %>&amp;addpeer=1">Add</a>
  </div>
  % }
  % if ($addpeer) {
  <form class="nd-bgp-add" data-nd-api-base="<%= $api_base %>" data-nd-device-id="<%= $id %>"
        style="margin-bottom:1em">
    <table class="datatable detail">
      <tbody>
      <tr><th>Remote IP</th><td><input type="text" name="bgppeeraddr" required style="width:14em"></td></tr>
      <tr><th>ID</th><td><input type="text" name="bgppeerid" required style="width:14em"></td></tr>
      <tr><th>Entity</th><td>
        <select name="entity">
          <option value="">[null]</option>
          % for my $eo (@$ent_opts) {
          <option value="<%= $eo->[0] %>"><%= $eo->[1] %></option>
          % }
        </select>
      </td></tr>
      <tr><th>State</th><td><input type="text" name="state" style="width:14em"></td></tr>
      <tr><th>Monitored?</th><td><label><input type="checkbox" name="monitored" value="1">yes</label></td></tr>
      <tr><th>Contact List</th><td>
        <select name="contactlist">
          <option value="">[null]</option>
          % for my $co (@$cl_opts) {
          <option value="<%= $co->[0] %>"><%= $co->[1] %></option>
          % }
        </select>
      </td></tr>
      </tbody>
    </table>
    <p style="margin:0.8em 0 0">
      <button type="submit" class="btn">Add</button>
      <a class="btn" href="<%= $bgp_url %>">Cancel</a>
    </p>
  </form>
  % }
  % if ($npeers) {
  % if ($editbgp) {
  <form class="nd-if-edit" data-nd-table="bgppeering" data-nd-api-base="<%= $api_base %>">
  % }
  <table class="datatable">
    <thead>
    <tr>
      % if ($editbgp) {
      <th></th>
      <th>Remote IP</th><th>ID</th><th>Entity</th><th>AS Name</th><th>AS Number</th><th>State</th><th>Monitored?</th><th>Contact List</th>
      % } else {
      <th><a href="<%= $sort_base %>&amp;peersort=ip">Remote IP</a></th>
      <th><a href="<%= $sort_base %>&amp;peersort=id">ID</a></th>
      <th><a href="<%= $sort_base %>&amp;peersort=entity">Entity</a></th>
      <th><a href="<%= $sort_base %>&amp;peersort=asname">AS Name</a></th>
      <th><a href="<%= $sort_base %>&amp;peersort=asnumber">AS Number</a></th>
      <th><a href="<%= $sort_base %>&amp;peersort=state">State</a></th>
      <th>Monitored?</th><th>Contact List</th>
      % }
    </tr>
    </thead>
    <tbody>
    % for my $row (@$rows) {
      % if (ref $row eq 'HASH' && defined $row->{section}) {
      % if ($row->{section}) {
    <tr><td colspan="<%= $editbgp ? 9 : 8 %>"><strong><%= $row->{section} %></strong></td></tr>
      % } else {
    <tr><td colspan="<%= $editbgp ? 9 : 8 %>">&nbsp;</td></tr>
      % }
      % } else {
      <tr data-nd-if="<%= $row->{id} %>">
        % if ($editbgp) {
        <td><input type="checkbox" class="nd-if-del" data-nd-del="bgppeering"></td>
        <td><input type="text" name="bgppeeraddr" value="<%= $row->{addr}[0] %>" data-nd-f="bgppeeraddr" data-nd-orig="<%= $row->{addr}[0] %>" style="width:14em"></td>
        % } else {
        <td>
          % if ($row->{addr}[1]) {
          <a href="<%= $row->{addr}[1] %>"><%= $row->{addr}[0] %></a>
          % } else {
          <%= $row->{addr}[0] %>
          % }
        </td>
        % }
        <td><%= $row->{pid} %></td>
        <td>
          % if ($row->{entity}[1]) {
          <a href="<%= $row->{entity}[1] %>"><%= $row->{entity}[0] %></a>
          % } else {
          <%= $row->{entity}[0] %>
          % }
        </td>
        <td><%= $row->{asname} %></td>
        <td>
          % if ($row->{asn}[1]) {
          <a target="_blank" href="<%= $row->{asn}[1] %>"><%= $row->{asn}[0] %></a>
          % } else {
          <%= $row->{asn}[0] %>
          % }
        </td>
        <td><%= $row->{state} %></td>
        % if ($editbgp) {
        <td><input type="checkbox" data-nd-f="monitored" data-nd-orig="<%= $row->{monitored} %>"<%= $row->{monitored} ? ' checked' : '' %></td>
        <td>
          % my $clval = defined $row->{contactlist}[0] ? $row->{contactlist}[0] : '';
          <select data-nd-f="contactlist" data-nd-orig="<%= $clval %>">
            <option value="">[null]</option>
            % for my $co (@$cl_opts) {
            <option value="<%= $co->[0] %>"<%= ( $clval ne '' && $clval eq $co->[0] ) ? ' selected' : '' %>><%= $co->[1] %></option>
            % }
          </select>
        </td>
        % } else {
        <td><%= $row->{monitored} ? 'yes' : 'no' %></td>
        <td>
          % if ($row->{contactlist}[2]) {
          <a href="<%= $row->{contactlist}[2] %>"><%= $row->{contactlist}[1] %></a>
          % }
        </td>
        % }
      </tr>
      % }
    % }
    </tbody>
  </table>
  % if ($editbgp) {
    <p style="margin:0.8em 0 0">
      <button type="button" class="btn nd-if-save">Save</button>
      <a class="btn" href="<%= $bgp_url %>">Cancel</a>
      &nbsp;&nbsp;<span style="color:#666;font-size:0.85em">Unchanged fields are not sent.</span>
    </p>
  </form>
  % }
  % } else {
  <p style="color:#666"><i><%= $empty_msg %></i></p>
  % }
  </div>
</div>
% }
% elsif ($view eq 'Rights') {
% # Access Rights (same mechanism as the Ipblock Rights section): display,
% # per-row remove (DELETE /api/userright|groupright/<id>), and the "Add
% # rights" form (POST /api/accessright). Visible to access_section, writable
% # by Admin (netdot.js initRights).
% my $can_rights      = $c->stash->{can_rights}      // 0;
% my $can_rights_edit = $c->stash->{can_rights_edit} // 0;
% my $rights          = $c->stash->{rights}          // [];
% my $right_users     = $c->stash->{right_users};
% my $right_groups    = $c->stash->{right_groups};
% if ($can_rights) {
<div class="container">
  <div class="containerhead">Access Rights</div>
  <div class="containerbody" style="padding:0.6em">
  % if ( @$rights ) {
    <table class="datatable" style="width:100%">
      <thead>
      <tr><th>Type</th><th>Subject</th><th>Right</th>
      % if ($can_rights_edit) {
      <th></th>
      % }
      </tr>
      </thead>
      <tbody>
      % for my $r (@$rights) {
          <tr>
              <td><%= $r->{type} eq 'user' ? 'User' : 'Group' %></td>
              <td><%== $r->{subject_html} %></td>
              <td><%= $r->{access_name} %></td>
% if ($can_rights_edit) {
              <td>
                  <button type="button" class="btn btn-sm nd-rights-del"
                          data-nd-api="<%= $c->web_prefix %>/api/<%= $r->{right_table} %>/<%= $r->{right_id} %>">Remove</button>
              </td>
% }
          </tr>
      % }
      </tbody>
    </table>
  % } else {
      <p style="color:#888"><i>No access rights for this device.</i></p>
  % }
% if ($can_rights_edit) {
    <form class="nd-rights-add" data-nd-api="<%= $c->web_prefix %>/api/accessright"
          data-nd-object-class="Device" data-nd-object-id="<%= $id %>" style="margin-top:0.6em">
    <table class="datatable detail" style="width:100%">
        <tbody>
        <tr><th>Subject</th><td>
            <select name="subject" required>
                <option value="">--SELECT--</option>
                % if ( ref $right_users && @$right_users ) {
                <optgroup label="Users">
                % for my $u (@$right_users) {
                <option value="user:<%= $u->[0] %>"><%= $u->[1] %></option>
                % }
                </optgroup>
                % }
                % if ( ref $right_groups && @$right_groups ) {
                <optgroup label="Groups">
                % for my $g (@$right_groups) {
                <option value="group:<%= $g->[0] %>"><%= $g->[1] %></option>
                % }
                </optgroup>
                % }
            </select>
        </td></tr>
        <tr><th>Right</th><td>
            <label><input type="checkbox" name="access" value="view"> View</label>
            <label><input type="checkbox" name="access" value="edit"> Edit</label>
            <label><input type="checkbox" name="access" value="delete"> Delete</label>
            <label><input type="checkbox" name="access" value="choose_ip"> Choose IP</label>
        </td></tr>
        </tbody>
    </table>
    <p style="margin-top:0.4em"><button type="submit" class="btn">Add rights</button></p>
    </form>
% }
  </div>
</div>
% }
% }
% elsif ($view eq 'Topology') {
% # Topology - Layer 2 (port of the legacy device.html "Topology" section):
% # a GraphViz graph of the L2 links around this device. The form is a plain
% # GET (view=Topology + the parameters); the PNG is generated on the fly
% # and embedded as a data: URI, with the GraphViz image map (clickable
% # nodes/edges) and the per-VLAN colour legend.
% my $depth_up  = $c->stash->{topo_depth_up}   // 1;
% my $depth_down= $c->stash->{topo_depth_down} // 1;
% my $tvlans    = $c->stash->{topo_vlans}      // 0;
% my $tnames    = $c->stash->{topo_names}      // 0;
% my $tminlen   = $c->stash->{topo_minlen}     // 1;
% my $troot     = $c->stash->{topo_root}       // '';
% my $tsvid     = $c->stash->{topo_svid}       // 0;
% my $vopts     = $c->stash->{topo_vlan_opts}  // [];
% my $terror    = $c->stash->{topo_error}      // '';
% my $timg      = $c->stash->{topo_img}        // '';
% my $tmap      = $c->stash->{topo_map}        // '';
% my $tlegend   = $c->stash->{topo_legend}     // [];

<div class="container">
  <div class="containerhead">Topology - Layer 2</div>
  <div class="containerbody">
  <p><strong>Note</strong>: depths greater than 2 may take a long time to render.</p>
  <form method="get" action="<%= $base %>" style="font-size:0.9em">
    <input type="hidden" name="view" value="Topology">
    <table>
      <tr>
        <th>Show Vlans?</th>
        <th>Show this Vlan only?</th>
        <th>Show Interface Names?</th>
        <th>Line length</th>
        <th>Depth up</th>
        <th>Depth down</th>
        <th>Reference Point</th>
        <th>&nbsp;</th>
      </tr>
      <tr>
        <td><input type="checkbox" name="topovlans" value="1"<%= $tvlans ? ' checked' : '' %>
               onchange="if(!this.checked){this.form.specific_vlan.value=0;}"></td>
        <td>
          <select name="specific_vlan"
                  onchange="if(this.value!=0){this.form.topovlans.checked=true;}">
            <option value=""<%= $tsvid ? '' : ' selected' %>>--Select--</option>
            % for my $v (@$vopts) {
            <option value="<%= $v %>"<%= $tsvid == $v ? ' selected' : '' %>><%= $v %></option>
            % }
          </select>
        </td>
        <td><input type="checkbox" name="toponames" value="1"<%= $tnames ? ' checked' : '' %></td>
        <td>
          <select name="topominlen">
            % for my $m (1 .. 3) {
            <option value="<%= $m %>"<%= $tminlen == $m ? ' selected' : '' %>><%= $m %></option>
            % }
          </select>
        </td>
        <td><input type="text" name="topodepth_up" size="2" value="<%= $depth_up %>"></td>
        <td><input type="text" name="topodepth_down" size="2" value="<%= $depth_down %>"></td>
        <td><input type="text" name="toporoot" size="20" value="<%= $troot %>"></td>
        <td><input type="submit" value="Change View"></td>
      </tr>
    </table>
  </form>
  % if ($terror) {
  <p style="color:#c00"><%= $terror %></p>
  % }
  % if ($timg) {
  <center>
    <img src="<%= $timg %>" usemap="#test" border="0">
    <%== $tmap %>
    % if (@$tlegend) {
    <br><b>List of vlans and their colors:</b><br>
    % for my $l (@$tlegend) {
    <a href="<%= $l->[2] %>"><span style="color:<%= $l->[1] %>"><b><%= $l->[0] %></b></span></a>
    % }
    % }
  </center>
  % }
  </div>
</div>
% }
% elsif ($view eq 'Hosted' || $view eq 'Circuits'
%        || $view eq 'STP' || $view eq 'Modules' || $view eq 'Audit'
%        || $view eq 'ARP' || $view eq 'FWT') {
% my $cols       = $c->stash->{cols}       // [];
% my $rows       = $c->stash->{rows}       // [];
% my $info       = $c->stash->{info}       // [];
% my $sort_base  = $c->stash->{sort_base}  // $base;
% my $sort_param = $c->stash->{sort_param} // 'sort';
% my $empty_msg  = $c->stash->{empty_msg}  // 'No data.';
% my $filter_param = $c->stash->{filter_param};
% my $filter_vids  = $c->stash->{filter_vids}  // [];
% my $filter_val   = $c->stash->{filter_val}   // '';

% if ($filter_param) {
<div style="margin:0.5em 0; font-size:0.9em">
  <form method="get" action="<%= $base %>" style="display:inline">
    <input type="hidden" name="view" value="<%= $view %>">
    VLAN:
    <select name="<%= $filter_param %>" onchange="this.form.submit()">
      <option value=""<%= $filter_val eq '' ? ' selected' : '' %>>all</option>
      % for my $v (@$filter_vids) {
      <option value="<%= $v %>"<%= $filter_val eq $v ? ' selected' : '' %>><%= $v %></option>
      % }
    </select>
  </form>
</div>
% }

% if (@$info) {
<p style="font-size:0.9em">
  % for my $i (0 .. $#$info) {
    % my ($l, $t, $h) = @{ $info->[$i] };
    <b><%= $l %>:</b>
    % if ($h) {
    <a href="<%= $h %>"><%= $t %></a>
    % } else {
    <%= $t // '' %>
    % }
    % if ($i < $#$info) {
    &nbsp;&nbsp;&nbsp;
    % }
  % }
</p>
% }

% if (!@$rows) {
<p style="color:#666"><i><%= $empty_msg %></i></p>
% } else {
<table class="datatable sortable">
  <thead>
    <tr>
    % for my $col (@$cols) {
      % my ($label, $skey) = @$col;
      % if ($skey) {
      <th><a href="<%= $sort_base %>&amp;<%= $sort_param %>=<%= $skey %>"><%= $label %></a></th>
      % } else {
      <th><%= $label %></th>
      % }
    % }
    </tr>
  </thead>
  <tbody>
    % for my $row (@$rows) {
    <tr>
      % for my $cell (@$row) {
      <td>
        % for my $i (0 .. $#$cell) {
          % my ($t, $h) = @{ $cell->[$i] };
          % if ($h) {
          <a href="<%= $h %>"><%= $t %></a>
          % } else {
          <%= $t // '' %>
          % }
          % if ($i < $#$cell) {
          ,
          % }
        % }
      </td>
      % }
    </tr>
    % }
  </tbody>
</table>
% }
% }
</div>
</div>
