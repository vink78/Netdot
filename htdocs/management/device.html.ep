<%# Device detail: read-only port of device.html (Basics + Interfaces views). %>
<% my $id     = $c->stash->{id} // ''; %>
<% my $view   = $c->stash->{view} // 'Basics'; %>
<% my $fqdn   = $c->stash->{fqdn} // ''; %>
<% my $title  = $c->stash->{title} // 'Device'; %>
<% my $base   = "/management/device/$id"; %>

<h1><%= $title %></h1>
<p>
  <b><%= $fqdn %></b>
  <a href="http://<%= $fqdn %>" target="_blank">[HTTP]</a>
  <a href="https://<%= $fqdn %>" target="_blank">[HTTPS]</a>
  <a href="<%= $base %>">[refresh]</a>
</p>

% my @tabs = ( [ 'Basics', 'Basics' ], [ 'Interfaces', 'Interfaces' ] );
<div style="margin:0.5em 0 1em 0; padding-bottom:0.4em; border-bottom:2px solid #ddeedd; font-size:0.95em">
% for my $i (0 .. $#tabs) {
    % my $t = $tabs[$i];
    <a href="<%= $base %>?view=<%= $t->[0] %>" style="<%= $view eq $t->[0] ? 'font-weight:bold; color:#000' : '' %>"><%= $t->[1] %></a>
    <span style="color:#ccc"><%= $i < $#tabs ? ' | ' : '' %></span>
% }
</div>

% if ($view eq 'Basics') {
% my $attrs  = $c->stash->{attrs}  // [];
% my $custom = $c->stash->{custom} // [];
<table class="sortable detail">
  <tbody>
    % for my $a (@$attrs) {
    <tr><th><%= $a->[0] %></th><td style="white-space:pre-wrap">
      % if ( defined $a->[2] ) {
      <a href="<%= $a->[2] %>"><%= $a->[1] %></a>
      % } else {
      <%= $a->[1] %>
      % }
    </td></tr>
    % }
  </tbody>
</table>

% if (@$custom) {
<h3>Custom Attributes</h3>
<table class="sortable detail">
  <tbody>
    % for my $a (@$custom) {
    <tr><th><%= $a->[0] %></th><td style="white-space:pre-wrap"><%= $a->[1] %></td></tr>
    % }
  </tbody>
</table>
% }
% }
% elsif ($view eq 'Interfaces') {
% my $rows      = $c->stash->{rows}      // [];
% my $vids      = $c->stash->{vids}      // [];
% my $showvlan  = $c->stash->{showvlan}  // 'all';
% my $show_jack = $c->stash->{show_jack} // 0;
% my $show_desc = $c->stash->{show_desc} // 0;
% my $sort_base = $c->stash->{sort_base} // $base;
<div style="margin:0.5em 0; font-size:0.9em">
  <form method="get" action="<%= $base %>" style="display:inline">
    <input type="hidden" name="view" value="Interfaces">
    VLAN:
    <select name="showvlan" onchange="this.form.submit()">
      <option value="all"% if ($showvlan eq 'all') { selected %}>all</option>
      % for my $v (@$vids) {
      <option value="<%= $v %>"% if ($showvlan eq $v) { selected %>><%= $v %></option>
      % }
    </select>
  </form>
  &nbsp;&nbsp; Legend:
  <span style="background-color:#cccccc">manual</span>
  <span style="background-color:#ff8e8e">removed</span>
</div>

% my @cols = (
%   [ 'number', 'Number', 'number' ],
%   [ 'name',   'Name',   'name'   ],
%   [ 'speed',  'Speed',  'speed'  ],
%   [ 'vlans',  'VLAN',   'vlan'   ],
%   [ 'status', 'Status', 'oper_status' ],
% );
% push @cols, [ 'jack',  'Jack',     'jack'  ] if $show_jack;
% push @cols, [ 'descr', 'Descr.',   'descr' ] if $show_desc;
% push @cols, [ 'conn',  'Connected Devices', undef ];

<table class="sortable">
  <thead>
    <tr>
    % for my $col (@cols) {
      % my ($key, $label, $skey) = @$col;
      % if ($skey) {
      <th><a href="<%= $sort_base %>&amp;ifsort=<%= $skey %>"><%= $label %></a></th>
      % } else {
      <th><%= $label %></th>
      % }
    % }
    </tr>
  </thead>
  <tbody>
    % for my $r (@$rows) {
    % if ($r->{style}) {
    <tr style="<%= $r->{style} %>">
    % } else {
    <tr>
    % }
      % for my $col (@cols) {
      % my $key  = $col->[0];
      % my $segs = $r->{$key};
      <td>
        % for my $i (0 .. $#$segs) {
          % my ($t, $h) = @{ $segs->[$i] };
          % if ($h) {
          <a href="<%= $h %>"><%= $t %></a>
          % } else {
          <%= $t %>
          % }
          % if ($i < $#$segs) {
          <br>
          % }
        % }
      </td>
      % }
    </tr>
    % }
  </tbody>
</table>
% }
