<h1>Devices <small>(<%= $total %> total, <%= scalar @{$devices} %> shown)</small></h1>

% if (@$devices) {
  <table class="tablescroll">
    <thead>
      <tr><th>id</th><th>name</th><th>os</th><th>snmp_target</th><th>owner</th></tr>
    </thead>
    <tbody>
      % for my $d (@$devices) {
      <tr>
        <td><%= $d->id %></td>
        <td><%= $d->name %></td>
        <td><%= $d->os // '' %></td>
        <td><%= $d->snmp_target // '' %></td>
        <td><%= $d->owner // '' %></td>
      </tr>
      % }
    </tbody>
  </table>
% } else {
  <p>No device.</p>
% }
