<%# Interface detail: port of interface.html (attributes editable in place + delete). %>
<% my $title      = $c->stash->{title}     // 'Interface'; %>
<% my $id         = $c->stash->{id}        // ''; %>
<% my $attrs      = $c->stash->{attrs}     // []; %>
<% my $vlans      = $c->stash->{vlans}     // []; %>
<% my $ips        = $c->stash->{ips}       // []; %>
<% my $neighbors  = $c->stash->{neighbors} // []; %>
<% my $fwt_links  = $c->stash->{fwt_links} // []; %>
<% my $arp_links  = $c->stash->{arp_links} // []; %>
<% my $audit      = $c->stash->{audit}     // []; %>
<% my $can_edit   = $c->stash->{can_edit}   // 0; %>
<% my $fields     = $c->stash->{fields}     // []; %>
<% my $api_path   = $c->stash->{api_path}   // ''; %>
<% my $can_delete = $c->stash->{can_delete} // 0; %>
<% my $del_path   = $c->stash->{del_path}   // ''; %>
<% my $del_goto   = $c->stash->{del_goto}   // ''; %>
<h1><%= $title %></h1>
<p>
  <a href="<%= url_for('interface_list') %>">&laquo; Interfaces</a>
  % if ( $can_edit && @$fields ) {
  <button type="button" class="btn" id="nd-edit-toggle" style="margin-left:1.2em">Edit</button>
  % }
  % if ( $can_delete ) {
  <button type="button" class="btn nd-rec-delete" data-nd-del="<%= $del_path %>" data-nd-goto="<%= $del_goto %>" style="margin-left:0.6em">Delete</button>
  % }
</p>

% # Read-only attributes table (2 pairs per row, like the generic detail page);
% # hidden while the Edit form is shown (wired by netdot.js initToggle).
<table class="datatable detail c2" id="nd-readonly">
  <tbody>
  % my @list = @$attrs;
  % for (my $i = 0; $i < @list; $i += 2) {
  %   my $end = $i + 1; $end = $#list if $end > $#list;
  %   my @r = @list[$i .. $end];
  <tr>
    % for my $a (@r) {
    <th><%= $a->[0] %></th><td style="white-space:pre-wrap">
      % if ( defined $a->[2] ) {
      <a href="<%= $a->[2] %>"><%= $a->[1] %></a>
      % } else {
      <%= $a->[1] %>
      % }
    </td>
    % }
  </tr>
  % }
  </tbody>
</table>

% # In-place edit form (hidden until the Edit toggle; wired by netdot.js):
% # PATCH /api/interface/<id> (same _edit_form partial as the generic detail page).
<%= $c->render_to_string( template => 'management/_edit_form', layout => 0,
                          can_edit => $can_edit, fields => $fields, api_path => $api_path ) %>

% if (@$vlans) {
<h3>VLANs</h3>
<table class="datatable"><tbody>
  % for my $v (@$vlans) {
    % my $l = Netdot::Mojo::Registry::link_for($v);
    % if ($l) {
  <tr><td><a href="<%= $l->[1] %>"><%= $l->[0] %></a></td></tr>
    % }
  % }
</tbody></table>
% }

% if (@$fwt_links) {
<h3>FWT entries</h3>
<table class="datatable"><tbody>
  % for my $l (@$fwt_links) {
  <tr><td><a href="<%= $l->[1] %>"><%= $l->[0] %></a></td></tr>
  % }
</tbody></table>
% }

% if (@$arp_links) {
<h3>ARP entries</h3>
<table class="datatable"><tbody>
  % for my $l (@$arp_links) {
  <tr><td><a href="<%= $l->[1] %>"><%= $l->[0] %></a></td></tr>
  % }
</tbody></table>
% }

% if (@$ips) {
<h3>IP addresses</h3>
<table class="datatable"><tbody>
  % for my $ip (@$ips) {
    % my $l = Netdot::Mojo::Registry::link_for($ip);
    % if ($l) {
  <tr><td><a href="<%= $l->[1] %>"><%= $l->[0] %></a></td></tr>
    % }
  % }
</tbody></table>
% }

% if (@$neighbors) {
<h3>Neighbors</h3>
<table class="datatable"><tbody>
  % for my $n (@$neighbors) {
    % my $l = Netdot::Mojo::Registry::link_for($n);
    % if ($l) {
  <tr><td><a href="<%= $l->[1] %>"><%= $l->[0] %></a></td></tr>
    % }
  % }
</tbody></table>
% }

% if (@$audit) {
<h3>Audit</h3>
<table class="datatable">
  <thead><tr><th>Timestamp</th><th>Username</th><th>Operation</th><th>Fields</th><th>Values</th></tr></thead>
  <tbody>
    % for my $a (@$audit) {
    <tr><td><%= $a->tstamp // '' %></td><td><%= $a->username // '' %></td><td><%= $a->operation // '' %></td><td style="white-space:pre-wrap"><%= $a->fields // '' %></td><td style="white-space:pre-wrap"><%= $a->vals // '' %></td></tr>
    % }
  </tbody>
</table>
% }
