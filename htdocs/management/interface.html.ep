<%# Interface detail: read-only port of interface.html. %>
<% my $title     = $c->stash->{title} // 'Interface'; %>
<% my $id        = $c->stash->{id} // ''; %>
<% my $attrs     = $c->stash->{attrs} // []; %>
<% my $vlans     = $c->stash->{vlans} // []; %>
<% my $ips       = $c->stash->{ips} // []; %>
<% my $neighbors = $c->stash->{neighbors} // []; %>
<% my $fwt_links = $c->stash->{fwt_links} // []; %>
<% my $arp_links = $c->stash->{arp_links} // []; %>
<% my $audit     = $c->stash->{audit} // []; %>
<h1><%= $title %></h1>
<p><a href="<%= url_for('interface_list') %>">&laquo; Interfaces</a></p>

<table class="datatable detail">
  <tbody>
    % for my $a (@$attrs) {
    <tr><th><%= $a->[0] %></th><td style="white-space:pre-wrap">
      % if ( defined $a->[2] ) {
      <a href="<%= $a->[2] %>"><%= $a->[1] %></a>
      % } else {
      <%= $a->[1] %>
      % }
    </td></tr>
    % }
  </tbody>
</table>

% if (@$vlans) {
<h3>VLANs</h3>
<table class="datatable"><tbody>
  % for my $v (@$vlans) {
    % my $l = Netdot::Mojo::Registry::link_for($v);
    % if ($l) {
  <tr><td><a href="<%= $l->[1] %>"><%= $l->[0] %></a></td></tr>
    % }
  % }
</tbody></table>
% }

% if (@$fwt_links) {
<h3>FWT entries</h3>
<table class="datatable"><tbody>
  % for my $l (@$fwt_links) {
  <tr><td><a href="<%= $l->[1] %>"><%= $l->[0] %></a></td></tr>
  % }
</tbody></table>
% }

% if (@$arp_links) {
<h3>ARP entries</h3>
<table class="datatable"><tbody>
  % for my $l (@$arp_links) {
  <tr><td><a href="<%= $l->[1] %>"><%= $l->[0] %></a></td></tr>
  % }
</tbody></table>
% }

% if (@$ips) {
<h3>IP addresses</h3>
<table class="datatable"><tbody>
  % for my $ip (@$ips) {
    % my $l = Netdot::Mojo::Registry::link_for($ip);
    % if ($l) {
  <tr><td><a href="<%= $l->[1] %>"><%= $l->[0] %></a></td></tr>
    % }
  % }
</tbody></table>
% }

% if (@$neighbors) {
<h3>Neighbors</h3>
<table class="datatable"><tbody>
  % for my $n (@$neighbors) {
    % my $l = Netdot::Mojo::Registry::link_for($n);
    % if ($l) {
  <tr><td><a href="<%= $l->[1] %>"><%= $l->[0] %></a></td></tr>
    % }
  % }
</tbody></table>
% }

% if (@$audit) {
<h3>Audit</h3>
<table class="datatable">
  <thead><tr><th>Timestamp</th><th>Username</th><th>Operation</th><th>Fields</th><th>Values</th></tr></thead>
  <tbody>
    % for my $a (@$audit) {
    <tr><td><%= $a->tstamp // '' %></td><td><%= $a->username // '' %></td><td><%= $a->operation // '' %></td><td style="white-space:pre-wrap"><%= $a->fields // '' %></td><td style="white-space:pre-wrap"><%= $a->vals // '' %></td></tr>
    % }
  </tbody>
</table>
% }
