<h1>Connexion</h1>

% if (defined(my $err = $c->stash('error'))) {
  <p class="error"><%= $err %></p>
% }

<form method="post" action="/login">
  <p>
    <label>Utilisateur
      <input type="text" name="username" value="<%= $username // '' %>" autofocus>
    </label>
  </p>
  <p>
    <label>Mot de passe
      <input type="password" name="password">
    </label>
  </p>
  <p><button type="submit">Se connecter</button></p>
</form>
