<h1>Login</h1>

% if (defined(my $err = $c->stash('error'))) {
  <p class="error"><%= $err %></p>
% }

<form method="post" action="/login">
  <p>
    <label>Username
      <input type="text" name="username" value="<%= $username // '' %>" autofocus>
    </label>
  </p>
  <p>
    <label>Password
      <input type="password" name="password">
    </label>
  </p>
  <p><button type="submit">Log in</button></p>
</form>
