% my $msg = $c->stash('message') // 'You do not have permission to view this page.';
<div class="container" style="max-width:480px;margin:2em auto">
  <div class="containerheadleft">Access denied</div>
  <div class="containerheadright">&nbsp;</div>
  <div class="containerbody">
    <p><%= $msg %></p>
    <p><a href="<%= url_for('home') %>">Return to home</a></p>
  </div>
</div>
