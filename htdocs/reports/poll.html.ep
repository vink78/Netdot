% my $titles = { addr => 'Network Addresses', dev => 'Devices', time => 'Poll Time' };
<h1><%= $titles->{$type} // 'Polling Stats' %></h1>
<p>Aggregated over time from the polling RRD database
   (<a href="/reports/pollstats">back to polling stats</a>).</p>

% my $periods = $periods // [];
% if ($rrd_ok) {
  % for my $p (@$periods) {
  <div class="container">
    <div class="containerhead"><%= $p->[1] %></div>
    <div class="containerbody">
      <p>RRD graph not available (no polling RRD data in this environment).</p>
    </div>
  </div>
  % }
% } else {
<div class="container">
  <div class="containerbody">
    <p>Polling statistics are not available: RRDtool is not installed in this environment.</p>
  </div>
</div>
% }
