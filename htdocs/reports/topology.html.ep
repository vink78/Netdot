% use Mojo::ByteStream qw(b);
<h1>Network Topology Graph</h1>
% if ($root) {
<p class="reportdesc">Root device: <strong><%= $root %></strong></p>
% }
% if ($note) {
<p style="color:#006600"><%= $note %></p>
% }
<div class="container">
  <div class="containerbody" style="color:#666">
    Note: Regenerating the topology graph for the whole network can consume a
    <strong>considerable amount of computing resources</strong>, depending on the
    number of devices and links. <strong>Please use cautiously!</strong>
  </div>
</div>

% my $cards = $cards // [];
% for my $card (@$cards) {
%   my $show_names = $c->stash('show_names');
%   my $minlen     = $c->stash('minlen');
<div class="container">
  <div class="containerhead"><%= $card->{title} %></div>
  <div class="containerbody">
    % if ($card->{exists}) {
      <img src="<%= $c->web_prefix %>/img/graphs/<%= $card->{file} %>" alt="topology" style="max-width:100%">
      <p><em>Generated at: <%= $card->{mtime} %> &middot; Size: <%= $card->{size} %> bytes</em></p>
    % } else {
      <p>Graph has not been generated yet.</p>
    % }
    <p>
      <a class="btn" href="<%= $c->web_prefix %>/reports/topology?regen=<%= $card->{key} %>&show_names=<%= $show_names %>&minlen=<%= $minlen %>">Regenerate</a>
    </p>
  </div>
</div>
% }

<div class="container">
  <div class="containerhead">Options</div>
  <div class="containerbody" style="padding:0.6em">
    <form method="get" action="<%= $c->web_prefix %>/reports/topology">
      <label>Show Interface Names
        <input type="checkbox" name="show_names" value="1"<%= ($c->stash('show_names')) ? ' checked' : '' %>>
      </label>
      &nbsp; Line Length
      <select name="minlen">
        % for my $i (1 .. 3) {
        <option value="<%= $i %>"<%= ($c->stash('minlen') == $i) ? ' selected' : '' %>><%= $i %></option>
        % }
      </select>
      <input type="submit" class="btn" value="Apply">
    </form>
  </div>
</div>
