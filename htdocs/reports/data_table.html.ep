% use Mojo::ByteStream qw(b);
% my $headers = $headers // [];
% my $rows    = $rows    // [];
% my $sortable = ($sortable ? 1 : 0);
% if ($title) {
<h1><%= $title %></h1>
% }
% if ($desc) {
<p class="reportdesc"><%= $desc %></p>
% }
% if (@$rows) {
<div class="tablescroll">
<table border="0" width="100%" cellspacing="0"<%= $sortable ? ' class="sortable"' : '' %>>
  <tr>
    % for my $h (@$headers) {
    <th class="formtabletitle"><%= b($h) %></th>
    % }
  </tr>
  % my $ri = 0;
  % for my $row (@$rows) {
  % my $cls = 'datatabler' . (($ri % 2) ? 1 : 2);
  <tr>
    % for my $cell (@$row) {
    <td class="<%= $cls %>"><%= b($cell // '') %></td>
    % }
  </tr>
  % $ri++;
  % }
</table>
</div>
% } else {
<p>No data.</p>
% }
