      <tr><td style="white-space:nowrap"><a href="/reports/poll?type=dev"><strong>Devices</strong></a></td>
          <td>Devices being polled for ARP caches and forwarding tables</td></tr>
      <tr><td style="white-space:nowrap"><a href="/reports/poll?type=time"><strong>Poll Time</strong></a></td>
          <td>Device polling time</td></tr>
    </table>
  </div>
