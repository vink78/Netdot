*~

# Most of these are produced by install
# We don't want them in the repo
.prefix
bin/oui.txt
etc/Site.conf*
etc/*.orig
etc/schema*
htdocs/reports/*.orig
upgrade/error.log
var/pollstats.rrd

# Generated GraphViz images (tree view); the directory itself is kept via .gitkeep
htdocs/img/graphs/*.png
export/*
