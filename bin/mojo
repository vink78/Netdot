#!/usr/bin/perl
use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../lib";

use Netdot::Mojo;

# Pattern standard (cf. Mojo::HelloWorld) : instancier, puis ->start sur l'instance.
# (->start en methode classe est casse en v9.39 : attributs lazy accedes sur le string).
my $app = Netdot::Mojo->new;
$app->start;
