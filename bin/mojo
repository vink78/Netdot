#!/usr/bin/perl
use strict;
use warnings;
use FindBin;
use lib "$FindBin::Bin/../lib";

use Netdot::Mojo;

# Standard pattern (cf. Mojo::HelloWorld): instantiate, then call ->start on the instance.
# (->start as a class method is broken in v9.39: lazy attrs accessed on the class string).
my $app = Netdot::Mojo->new;
$app->start;
